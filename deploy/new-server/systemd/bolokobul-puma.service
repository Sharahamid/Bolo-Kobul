[Unit]
Description=Bolo Kobul website (Puma)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/bolokobul/current
Environment=RAILS_ENV=production
Environment=PATH=/opt/rubies/ruby-2.6.3/bin:/opt/node-16.20.2/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/rubies/ruby-2.6.3/bin/bundle exec puma -C config/puma.rb
# Zero-downtime restart after a code update: sudo systemctl reload bolokobul-puma
ExecReload=/bin/kill -USR2 $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
