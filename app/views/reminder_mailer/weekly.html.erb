<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr><td align="center" style="padding: 2rem 1rem;">
<table width="100%" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%;">

  <tr><td style="background:#ffffff; border-radius:8px 8px 0 0; text-align:center; padding: 2rem 2rem 1rem;">
    <img src="https://www.bolokobul.com/assets/bk_logo-d410475b2bfdeb425af379c0193908b7a02336b47f98b379e58edd6ba21c8435.png" width="80" style="margin-bottom:10px;" alt="Bolo Kobul" />
    <div style="font-size:11px; color:#888;<%= ' letter-spacing:2px; text-transform:uppercase;' unless I18n.locale == :bn %>"><%= t('email.tagline') %></div>
    <div style="width:40px; height:2px; background:#FFB627; margin:12px auto 0;"></div>
  </td></tr>

  <tr><td style="background:#FFB627; padding: 2rem; text-align:center;">
    <div style="font-size:28px;">🦋</div>
    <div style="font-size:22px; font-weight:bold; color:#ffffff; line-height:1.3; margin-top:8px;">
      <%= @reminder[:title] %>
    </div>
    <div style="font-size:14px; color:#fff3cc; margin-top:8px;"><%= t('email.dear', name: @receiver.name.presence || t('email.member')) %></div>
  </td></tr>

  <tr><td style="background:#ffffff; padding: 2rem;">
    <% @reminder[:lines].each_with_index do |line, i| %>
      <p style="font-size:15px; color:#333333; line-height:1.8; margin:0 0 <%= i == @reminder[:lines].size - 1 ? '1.5rem' : '1rem' %>;"><%= line %></p>
    <% end %>

    <% if @reminder[:matches].present? %>
      <table width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 1.5rem;">
        <% @reminder[:matches].each do |m| %>
          <tr><td style="padding:0 0 10px;">
            <a href="<%= m[:link] %>" style="text-decoration:none; display:block;">
              <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #F3E3BD; border-radius:10px; background:#FFFDF7;">
                <tr>
                  <td width="76" style="padding:12px 0 12px 12px; vertical-align:middle;">
                    <% if m[:photo] %>
                      <img src="<%= m[:photo] %>" width="64" height="64" alt="" style="display:block; width:64px; height:64px; border-radius:50%; object-fit:cover; border:2px solid #FFB627;">
                    <% else %>
                      <div style="width:64px; height:64px; border-radius:50%; background:#FFF3CC; border:2px solid #FFB627; text-align:center; line-height:64px; font-size:24px;">🦋</div>
                    <% end %>
                  </td>
                  <td style="padding:12px; vertical-align:middle;">
                    <div style="font-size:15px; font-weight:bold; color:#854F0B;"><%= m[:id] %><%= ' ✔' if m[:verified] %></div>
                    <div style="font-size:13px; color:#555555; line-height:1.6; margin-top:2px;"><%= m[:details] %></div>
                  </td>
                  <% if m[:percent].positive? %>
                    <td width="64" style="padding:12px 12px 12px 0; vertical-align:middle; text-align:right;">
                      <span style="background:#FFB627; color:#633806; font-size:12px; font-weight:bold; padding:4px 8px; border-radius:12px; white-space:nowrap;"><%= local_digits(m[:percent]) %>%</span>
                    </td>
                  <% end %>
                </tr>
              </table>
            </a>
          </td></tr>
        <% end %>
      </table>
    <% end %>
    <% if @reminder[:complete_nudge] %>
      <div style="background:#FFF8E7; border:1px solid #FAC775; border-radius:8px; padding:14px 16px; margin-bottom:1.5rem; font-size:14px; color:#633806; line-height:1.6;">
        <%= @reminder[:complete_nudge][:text] %>
        <a href="<%= @reminder[:complete_nudge][:link] %>" style="color:#C77C00; font-weight:bold;"><%= t('email.weekly.complete') %></a>
      </div>
    <% end %>
    <div style="background:#FFF8E7; border-left:3px solid #FFB627; padding:14px 16px; margin-bottom:1.5rem;">
      <div style="font-size:13px; color:#555555; line-height:1.7;">
        <%= t('email.weekly.privacy_html') %>
      </div>
    </div>

    <div style="text-align:center; margin: 1.5rem 0;">
      <a href="<%= @reminder[:link] %>" style="background:#FFB627; color:#ffffff; text-decoration:none; padding:14px 36px; border-radius:6px; font-size:15px; font-weight:bold; display:inline-block;"><%= @reminder[:button] %></a>
    </div>
  </td></tr>

  <tr><td style="background:#FFF8E7; padding:1.5rem 2rem; text-align:center; border-top:1px solid #FFE082;">
    <div style="font-size:14px; color:#888888; line-height:1.8;"><%= t('email.warm_wishes') %></div>
    <div style="font-size:15px; font-weight:bold; color:#FFB627; margin-top:4px;"><%= t('email.team') %></div>
    <div style="margin-top:16px;">
      <a href="https://www.facebook.com/BoloKobulLtd" target="_blank"
         style="display:inline-block; background:#1877F2; color:#ffffff; text-decoration:none;
                width:32px; height:32px; border-radius:50%; line-height:32px; font-size:15px;
                font-weight:bold; margin:0 4px; text-align:center;">f</a>
      <a href="https://www.instagram.com/bolokobul/" target="_blank"
         style="display:inline-block; background:#E4405F; color:#ffffff; text-decoration:none;
                width:32px; height:32px; border-radius:50%; line-height:32px; font-size:14px;
                font-weight:bold; margin:0 4px; text-align:center;">in</a>
      <a href="https://x.com/BoloKobul" target="_blank"
         style="display:inline-block; background:#000000; color:#ffffff; text-decoration:none;
                width:32px; height:32px; border-radius:50%; line-height:32px; font-size:14px;
                font-weight:bold; margin:0 4px; text-align:center;">&#120143;</a>
      <a href="https://wa.me/8801611820410" target="_blank"
         style="display:inline-block; background:#25D366; color:#ffffff; text-decoration:none;
                width:32px; height:32px; border-radius:50%; line-height:32px; font-size:14px;
                font-weight:bold; margin:0 4px; text-align:center;">W</a>
    </div>
    <div style="font-size:10px; color:#cccccc; margin-top:10px;">
      <%= t('email.follow_html') %>
    </div>
    <div style="font-size:11px; color:#aaaaaa; margin-top:12px;">
      <a href="https://www.bolokobul.com" style="color:#FFB627; text-decoration:none;">bolokobul.com</a> &nbsp;|&nbsp;
      <a href="mailto:support@bolokobul.com" style="color:#FFB627; text-decoration:none;">support@bolokobul.com</a>
    </div>
    <div style="font-size:11px; color:#aaaaaa; margin-top:10px;">
      <%= t('email.weekly.footer_html', unsubscribe: link_to(t('email.weekly.unsubscribe'), @unsubscribe_url, style: 'color:#aaaaaa;')) %>
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
