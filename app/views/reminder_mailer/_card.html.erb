<%# One profile card in the weekly email (waiting Kobuls and matches) %>
<a href="<%= m[:link] %>" style="text-decoration:none; display:block;">
  <table width="100%" cellpadding="0" cellspacing="0" style="border:1px solid #F3E3BD; border-radius:10px; background:#FFFDF7;">
    <tr>
      <td width="76" style="padding:12px 0 12px 12px; vertical-align:middle;">
        <% if m[:photo] %>
          <img src="<%= m[:photo] %>" width="64" height="64" alt="" style="display:block; width:64px; height:64px; border-radius:50%; object-fit:cover; border:2px solid #FFB627;">
        <% else %>
          <div style="width:64px; height:64px; border-radius:50%; background:#FFF3CC; border:2px solid #FFB627; text-align:center; line-height:64px; font-size:24px;">🦋</div>
        <% end %>
      </td>
      <td style="padding:12px; vertical-align:middle;">
        <div style="font-size:15px; font-weight:bold; color:#854F0B;"><%= m[:id] %><%= ' ✔' if m[:verified] %><% if m[:tag] %> <span style="background:#412402; color:#FFB627; font-size:11px; font-weight:bold; padding:2px 8px; border-radius:10px; white-space:nowrap; vertical-align:middle;"><%= m[:tag] %></span><% end %></div>
        <div style="font-size:13px; color:#555555; line-height:1.6; margin-top:2px;"><%= m[:details] %></div>
        <% if m[:note] %><div style="font-size:12px; color:#C0392B; font-weight:bold; margin-top:3px;">⏳ <%= m[:note] %></div><% end %>
      </td>
      <% if m[:percent].positive? %>
        <td width="64" style="padding:12px 12px 12px 0; vertical-align:middle; text-align:right;">
          <span style="background:#FFB627; color:#633806; font-size:12px; font-weight:bold; padding:4px 8px; border-radius:12px; white-space:nowrap;"><%= local_digits(m[:percent]) %>%</span>
        </td>
      <% end %>
    </tr>
  </table>
</a>
