<div style="display:flex; flex-direction:column; height:auto; background:#fff;">
  <div style="background:#fffaf0; border-bottom:0.5px solid #FAC775; padding:10px 16px; display:flex; align-items:center; gap:8px; flex-shrink:0;">
    <i class="fas fa-comment-dots" style="color:#854F0B; font-size:14px;"></i>
    <span style="font-size:14px; font-weight:700; color:#412402;">
      <%= profile&.unique_id %><%= " (#{profile.user.created_for})" if profile && !profile.user.self? %>
    </span>
  </div>
  <div class="conversation-list chat_screen" id="messageBody" style="max-height:100px; overflow-y:auto; padding:8px 16px;">
    <%= render 'messages/conversation_list', messages: chat_room.messages %>
  </div>
  <div class="bk-chat-compose" style="border-top:0.5px solid #FAC775; padding:10px 12px; background:#fffaf0; flex-shrink:0;">
    <%= render 'messages/chat_form', profile: profile, chat_room: chat_room, message: message %>
  </div>
</div>
<script>
  var mb = document.getElementById("messageBody");
  if (mb) mb.scrollTop = mb.scrollHeight;
  // On phones, bring the message box into view (just above the bottom bar) when a chat opens
  if (window.matchMedia && window.matchMedia('(max-width: 575.98px)').matches) {
    setTimeout(function () {
      var compose = document.querySelector('.bk-chat-compose');
      if (!compose) return;
      var bottomBar = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--bk-bottom-nav-h'), 10) || 70;
      var bottom = compose.getBoundingClientRect().bottom + window.pageYOffset;
      window.scrollTo(0, Math.max(0, bottom - window.innerHeight + bottomBar + 8));
    }, 350);
  }
</script>
