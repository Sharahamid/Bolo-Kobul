<%= form_for message, remote: true, autocomplete: false do |f| %>
  <%# "Replying to …" bar, filled in by room_channel.js when a message is chosen %>
  <div class="bk-reply-bar" id="bk-reply-bar" hidden>
    <div class="bk-reply-bar__body">
      <span class="bk-reply-bar__who" id="bk-reply-who"></span>
      <span class="bk-reply-bar__text" id="bk-reply-text"></span>
    </div>
    <button type="button" class="bk-reply-bar__close" id="bk-reply-cancel" aria-label="<%= t('chat.cancel_reply') %>">✕</button>
  </div>
  <%= f.hidden_field :reply_to_id, value: '', id: 'message_reply_to_id' %>
  <div style="display:flex; gap:8px; align-items:flex-end;">
    <%= f.text_area :body,
                     id: 'message_text',
                     rows: 1,
                     autocomplete: 'off',
                     placeholder: t('chat.type_message'),
                     style: 'flex:1; border:0.5px solid #FAC775; border-radius:20px; padding:9px 16px; font-size:13px; line-height:1.4; background:#fff; color:#412402; outline:none; resize:none; overflow-y:auto; max-height:120px; font-family:inherit;',
                     data: { chat_room_id: chat_room.id, recipient_id: profile.id,
                             placeholder_connected: t('chat.send_message'), placeholder_connecting: t('chat.connecting') },
                     date: format_date_messaging(Time.zone.now) %>
    <%= f.hidden_field :chat_room_id, value: chat_room.id %>
    <%= f.hidden_field :recipient_id, value: profile.id %>
    <button type="submit" class="send-private-message msg-send-btn" style="background:#FFB627; color:#412402; border:none; border-radius:50%; width:38px; height:38px; display:flex; align-items:center; justify-content:center; cursor:pointer; flex-shrink:0;">
      <i class="fas fa-paper-plane" style="font-size:14px;"></i>
    </button>
  </div>
<% end %>
