<%# Shared by the chat list page (/messages) and a single chat (/messages/:id/profile) %>
<style>
.bk-chat-container { margin-bottom: 20px; }
.bk-chat-container .message-page { height: 460px !important; position: relative !important; }
.bk-chat-container .message-right-sidebar { height: 460px !important; overflow: hidden; display: flex; flex-direction: column; }
.bk-chat-container .profile-chat-window { flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
.bk-chat-container .conversation-list.chat_screen { overflow-y: auto; max-height: 400px !important; }
.bk-chat-container .chat-list-window { max-height: 400px !important; min-height: 0 !important; overflow-y: auto; }
/* Phones: the chat list, menu and conversation are stacked, so let the page grow
   instead of cutting off the message box below a fixed height */
@media (max-width: 575.98px) {
  .bk-chat-container .message-page,
  .bk-chat-container .message-right-sidebar { height: auto !important; overflow: visible; }
  .bk-chat-container .conversation-list.chat_screen { max-height: 55vh !important; min-height: 160px; }
  /* The message box could be cut off by the chat window's fixed size, leaving nowhere
     to type. Let the window grow so the box sits right under the messages. */
  .bk-chat-container .profile-chat-window { flex: none; overflow: visible; }
}
</style>
