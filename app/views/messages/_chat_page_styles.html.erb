<%# Shared by the chat list page (/messages) and a single chat (/messages/:id/profile) %>
<style>
/* ---- Conversation starters (until the member's first message) ---- */
.bk-icebreakers { margin:0 0 10px; }
.bk-icebreakers__title { font-size:12px; font-weight:700; color:#854F0B; margin:0 0 6px; }
.bk-icebreakers__list { display:flex; gap:8px; overflow-x:auto; padding-bottom:4px; scrollbar-width:thin; -webkit-overflow-scrolling:touch; }
.bk-icebreakers__chip { flex:0 0 auto; max-width:240px; white-space:normal; text-align:left; border:1px solid #FAC775; background:#fff;
                        color:#633806; font-size:12px; line-height:1.4; padding:7px 12px; border-radius:14px; cursor:pointer; }
.bk-icebreakers__chip:hover, .bk-icebreakers__chip:focus { background:#FFF3CC; outline:none; }

/* ---- Chat messages and WhatsApp-style replies ---- */
.bk-msg { display:flex; align-items:center; gap:6px; margin-bottom:8px; position:relative; touch-action:pan-y; }
.bk-msg--mine { justify-content:flex-end; }
.bk-msg--mine .bk-msg__reply { order:-1; }
.bk-msg__wrap { max-width:260px; min-width:0; transition:transform .15s ease; }
.bk-msg__bubble { padding:8px 14px; font-size:13px; line-height:1.5; word-wrap:break-word; overflow-wrap:anywhere; }
.bk-msg--mine .bk-msg__bubble { background:#FFB627; color:#412402; border-radius:14px 4px 14px 14px; }
.bk-msg--theirs .bk-msg__bubble { background:#f0f0f0; color:#444; border-radius:4px 14px 14px 14px; }
.bk-msg__text { white-space:pre-wrap; }
.bk-msg__meta { font-size:10px; color:#aaa; margin-top:3px; }
.bk-msg--mine .bk-msg__meta { text-align:right; }
.bk-msg__quote { display:block; margin:0 0 6px; padding:5px 8px; border-radius:6px; text-decoration:none !important;
                 background:rgba(255,255,255,.55); border-left:3px solid #854F0B; color:inherit; }
.bk-msg--theirs .bk-msg__quote { background:#fff; border-left-color:#FFB627; }
.bk-msg__quote-who { display:block; font-size:11px; font-weight:700; color:#854F0B; }
.bk-msg__quote-text { display:block; font-size:12px; color:#6b5a45; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bk-msg__reply { flex-shrink:0; width:28px; height:28px; border-radius:50%; border:0; background:#FFF3CC; color:#854F0B;
                 font-size:14px; line-height:28px; padding:0; cursor:pointer; opacity:0; transition:opacity .15s; }
.bk-msg:hover .bk-msg__reply, .bk-msg__reply:focus { opacity:1; }
@media (hover: none) { .bk-msg__reply { display:none; } }
.bk-msg--flash .bk-msg__bubble { box-shadow:0 0 0 3px rgba(255,182,39,.55); }
.bk-reply-bar { display:flex; align-items:center; gap:8px; margin:0 0 8px; padding:6px 10px; border-radius:10px;
                background:#FFF8E7; border-left:3px solid #FFB627; }
.bk-reply-bar[hidden] { display:none; }
.bk-reply-bar__body { flex:1; min-width:0; }
.bk-reply-bar__who { display:block; font-size:11px; font-weight:700; color:#854F0B; }
.bk-reply-bar__text { display:block; font-size:12px; color:#6b5a45; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.bk-reply-bar__close { border:0; background:transparent; color:#854F0B; font-size:14px; cursor:pointer; padding:2px 6px; }
.bk-chat-container { margin-bottom: 20px; }
.bk-chat-container .message-page { height: 460px !important; position: relative !important; }
.bk-chat-container .message-right-sidebar { height: 460px !important; overflow: hidden; display: flex; flex-direction: column; }
.bk-chat-container .profile-chat-window { flex: 1; overflow: hidden; display: flex; flex-direction: column; min-height: 0; }
/* The tab bar's box wraps the chat window, so it must share out the height too -
   otherwise a tall message list pushes the typing box out of sight */
.bk-chat-container .message-right-sidebar > .dashboard-tab { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
.bk-chat-container .message-right-sidebar > .dashboard-tab > ul { flex-shrink: 0; }
/* The chat window fills the space under the tabs: header on top, typing box pinned
   at the bottom, and only the messages in between scroll. */
.bk-chat-container .profile-chat-window > div { flex: 1 1 auto; min-height: 0; }
.bk-chat-container .conversation-list.chat_screen { overflow-y: auto; flex: 1 1 auto; min-height: 0; max-height: none !important; }
.bk-chat-container .bk-chat-compose { flex-shrink: 0; }
.bk-chat-container .chat-list-window { max-height: 400px !important; min-height: 0 !important; overflow-y: auto; }
/* Phones: the chat list, menu and conversation are stacked, so let the page grow
   instead of cutting off the message box below a fixed height */
@media (max-width: 575.98px) {
  .bk-chat-container .message-page,
  .bk-chat-container .message-right-sidebar { height: auto !important; overflow: visible; }
  .bk-chat-container .conversation-list.chat_screen { max-height: 55vh !important; min-height: 160px; }
  /* The message box could be cut off by the chat window's fixed size, leaving nowhere
     to type. Let the window grow so the box sits right under the messages. */
  .bk-chat-container .profile-chat-window,
  .bk-chat-container .profile-chat-window > div,
  .bk-chat-container .message-right-sidebar > .dashboard-tab { flex: none; overflow: visible; display: block; }
}
</style>
