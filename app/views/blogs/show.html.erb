<%# Own title, description and preview picture, so Google and link previews show this article %>
<% content_for :title, @blog.title %>
<% content_for :meta_description, strip_tags(@blog.story.to_s).squish.truncate(155, separator: ' ') %>
<% if @blog.image.attached? %><% content_for :og_image, request.base_url + @blog.image_url %><% end %>
<% content_for :og_type, "article" %>
<div style="background:#f7f5f0; min-height:100vh; padding:24px 0;">
  <div class="container" style="max-width:860px;">

    <!-- Back link -->
    <div style="margin-bottom:16px;">
      <%= link_to blogs_path(type: @blog.story_type), style: "font-size:12px; color:#854F0B; text-decoration:none; display:inline-flex; align-items:center; gap:4px;" do %>
        ← <%= @blog.success_story? ? 'All success stories' : 'All articles' %>
      <% end %>
    </div>

    <!-- Main card -->
    <div style="border:0.5px solid #FAC775; border-radius:14px; overflow:hidden; background:#fff; box-shadow:1px 3px 9px rgba(0,0,0,0.07);">

      <!-- Image -->
      <div style="width:100%; background:#fff8ee; display:flex; align-items:center; justify-content:center;">
        <%= image_tag "#{@blog.image_url.present? ? @blog.image_url : 'bg01.jpg'}",
                      style: "width:100%; max-height:380px; object-fit:contain; background:#fff8ee; display:block;",
                      class: "img-responsive" %>
      </div>

      <!-- Content -->
      <div style="padding:28px 32px;">

        <!-- Title bar -->
        <div style="border-left:4px solid #FFB627; padding-left:14px; margin-bottom:20px;">
          <h2 style="font-size:20px; font-weight:700; color:#412402; margin:0 0 4px;"><%= @blog.title %></h2>
          <p style="font-size:12px; color:#aaa; margin:0;">
            <i class="fas fa-heart" style="color:#FFB627; margin-right:4px;"></i>
            <%= @blog.story_type&.titleize || 'Blog' %>
          </p>
        </div>

        <!-- Story text -->
        <div class="bk-rich-text" style="font-size:15px; color:#4a4a4a; line-height:1.8;">
          <%= formatted_story(@blog.story) %>
        </div>

        <% related = (@blog.related(3) rescue []) %>
        <% if related.any? %>
          <%# You may also like: related articles (paired topics first, then similar ones) %>
          <div class="bk-related" style="margin-top:28px;">
            <h3 style="font-size:16px; font-weight:700; color:#412402; margin:0 0 12px;"><%= t('blog_related.title') %></h3>
            <div class="bk-related-grid">
              <% related.each do |post| %>
                <%= link_to blog_path(post), class: 'bk-related-card' do %>
                  <%= image_tag(post.image_url.present? ? post.image_url(:card) : 'bg01.jpg', alt: '', loading: 'lazy', width: 300, height: 300) %>
                  <span class="bk-related-text">
                    <span class="bk-related-kind"><%= post.success_story? ? t('blog_related.story') : (post.story_type.to_s.humanize.presence || t('blog_related.article')) %></span>
                    <span class="bk-related-title"><%= post.title %></span>
                  </span>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>

        <!-- Footer -->
        <div style="margin-top:24px; padding-top:16px; border-top:0.5px solid #eee; display:flex; align-items:center; justify-content:space-between;">
          <span></span>
          <%= link_to blogs_path(type: @blog.story_type), style: "background:#FAEEDA; color:#854F0B; border:0.5px solid #FFB627; border-radius:8px; padding:8px 16px; font-size:12px; font-weight:600; text-decoration:none;" do %>
            ← <%= @blog.success_story? ? 'More success stories' : 'More articles' %>
          <% end %>
        </div>
      </div>
    </div>

  </div>
</div>
