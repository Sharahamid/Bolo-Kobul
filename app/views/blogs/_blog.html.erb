<%# The picture is always a square (covers are made square), so nothing is cut off %>
<div class="bk-blog-card" style="border:0.5px solid #FAC775; border-radius:12px; background:#fffaf0; overflow:hidden; margin-bottom:12px; display:flex; align-items:flex-start; gap:4px; padding:12px 0 12px 12px;">
  <div class="bk-blog-thumb" style="position:relative; width:128px; aspect-ratio:1 / 1; flex-shrink:0; overflow:hidden; border-radius:10px; background:#fff8ee;">
    <%= image_tag "#{blog.image_url.present? ? blog.image_url(:card) : 'bg01.jpg'}", loading: 'lazy', alt: blog.title,
                  style: "position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center 25%; display:block;",
                  class: "img-responsive" %>
  </div>
  <div style="padding:0 14px 0 10px; flex:1; min-width:0;">
    <h4 style="font-size:14px; font-weight:700; color:#633806; margin:0 0 6px; line-height:1.4;">
      <%= blog.title %>
    </h4>
    <% if blog.story_type.present? && blog.story_type != 'success_story' %>
      <span style="background:#fff3cd; color:#856404; font-size:10px; padding:2px 10px; border-radius:12px; font-weight:600; display:inline-block; margin-bottom:6px;">
        <%= blog.story_type.humanize %>
      </span>
    <% end %>
    <div style="font-size:12px; color:#777; line-height:1.6; margin-bottom:10px; overflow:hidden; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;">
      <%= safe_html(blog.story) %>
    </div>
    <%= link_to blog_path(blog), style: "background:#FAEEDA; color:#854F0B; border:0.5px solid #FFB627; border-radius:6px; padding:5px 12px; font-size:11px; font-weight:600; text-decoration:none; display:inline-block;" do %>
      Read Full Story →
    <% end %>
  </div>
</div>
