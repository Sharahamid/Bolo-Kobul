<%# How It Works: real text steps (readable on phones, in English and Bangla).
    The butterfly numbers come from Admin > Butterfly Config. %>
<% c = bk_costs %>
<% vars = { n1: local_digits(c[:n1]), n2: local_digits(c[:n2]),
            b1: butterflies_label(c[:n1]), b2: butterflies_label(c[:n2]),
         days: local_digits(ButterflyConfig.kobul1_expiry_days) } %>
<% icons = %w[fa-user-plus fa-sliders-h fa-search fa-paper-plane fa-unlock-alt fa-comment-dots fa-shield-alt fa-ring] %>

<div class="container bk-how" style="padding-top:20px; padding-bottom:36px;">
  <div class="bk-how-head">
    <h1><%= t('bkx.how.title') %></h1>
    <p><%= t('bkx.how.subtitle') %></p>
  </div>

  <ol class="bk-how-steps">
    <% (1..8).each do |n| %>
      <li class="bk-how-step">
        <div class="bk-how-icon"><i class="fas <%= icons[n - 1] %>"></i></div>
        <div class="bk-how-body">
          <div class="bk-how-num"><%= t('bkx.how.step', n: local_digits(n)) %></div>
          <h2><%= t("bkx.how.steps.s#{n}_title") %></h2>
          <p><%= t("bkx.how.steps.s#{n}_text", **vars) %></p>
        </div>
      </li>
    <% end %>
  </ol>

  <%# Optional BK+ note: not a step, so the free journey stays clear. Cheapest plan comes from Admin > BK+ plans. %>
  <% cheapest = BkPlusPlan.for_sale.min_by(&:price) %>
  <div style="max-width:820px; margin:18px auto 0; background:#FFF8E6; border:1px solid #F1D48A; border-radius:16px; padding:18px 22px; display:flex; gap:14px; align-items:flex-start;">
    <div style="flex:0 0 44px; width:44px; height:44px; border-radius:50%; background:#FFB627; color:#412402; display:flex; align-items:center; justify-content:center; font-size:18px;"><i class="fas fa-crown"></i></div>
    <div style="flex:1; min-width:0;">
      <strong style="display:block; color:#412402; font-size:16px; margin-bottom:4px;"><%= t('bkx.how.plus_title') %></strong>
      <p style="margin:0 0 8px; color:#555; font-size:14px; line-height:1.6;">
        <%= t('bkx.how.plus_text') %>
        <% if cheapest %><%= t('bkx.how.plus_from', price: taka(cheapest.price), plan: cheapest.label) %><% end %>
      </p>
      <%= link_to t('bkx.how.plus_link'), bk_plus_path, style: "color:#854F0B; font-weight:600; font-size:14px; text-decoration:underline;" %>
    </div>
  </div>

  <div class="bk-how-cta">
    <div>
      <strong><%= t('bkx.how.cta_title') %></strong>
      <span><%= t('bkx.how.cta_text') %></span>
    </div>
    <% if current_user && current_active_profile %>
      <%= link_to t('bkx.how.cta_member'), search_page_marriage_profile_path(current_active_profile), class: 'bk-pill-btn' %>
    <% else %>
      <%= link_to t('bkx.how.cta'), root_path, class: 'bk-pill-btn' %>
    <% end %>
  </div>
</div>
