<div class="update-notice flash-msg-profile-change"></div>
<div class="container-fluid p-0 ">
  <div class="dashboard">
    <div class="container">
      <div class="d-sm-flex flex-sm-row ">
        <%= render 'home/dashboard/left_sidebar', marriage_profile: @marriage_profile %>
        <%# "Edit Profile" links here (#profile-details); the margin keeps it clear of the top bar %>
        <div class="right-section" id="profile-details" style="scroll-margin-top:72px;">
          <%= render 'home/dashboard/dashboard_tabs', marriage_profile: @marriage_profile %>
          <% profile_ad = Ad.for_profile_page %>
          <%= render 'marriage_profiles/marriage_profile_information', marriage_profile: @marriage_profile, profile_ad: profile_ad %>
          <%# Phones: the "Profile page" ad goes below the profile details (computers: beside the photos) %>
          <% if profile_ad %>
            <%= render 'shared/profile_page_ad', ad: profile_ad, extra_class: 'd-sm-none bk-profile-ad--inline' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>

<% if current_active_profile&.id == @marriage_profile.id %>
<script>
  // "Update Your Occupation" and the other prompts link here with #update-<section>:
  // open that section, scroll to it and open its add/edit form
  (function () {
    var sections = {
      'update-id-document': 'collapse_basic_profile_info', 'update-education': 'collapse_academic_info',
      'update-occupation': 'collapse_occupation', 'update-appearance': 'collapse_appearance',
      'update-family': 'collapse_family_details', 'update-life-style': 'collapse_life_style',
      'update-hobbies': 'collapse_hobbies_interest', 'update-cultural': 'collapse_cultural_values',
      'update-about': 'collapse_about'
    };
    function openSection() {
      var key = window.location.hash.replace('#', '');
      if (key === 'update-photo') {
        var photos = document.getElementById('marriage_profile_photos');
        if (photos) photos.scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      var panel = document.getElementById(sections[key]);
      if (!panel) return;
      $(panel).collapse('show');
      var box = panel.closest('.profile-info-item') || panel;
      box.style.scrollMarginTop = '80px';
      box.scrollIntoView({ behavior: 'smooth', block: 'start' });
      var form = panel.querySelector('a[data-remote="true"]');
      if (form) form.click();
    }
    $(openSection);
    window.addEventListener('hashchange', openSection);
  })();
</script>
<% end %>
