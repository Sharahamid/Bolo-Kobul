<div class="update-notice flash-msg-profile-change"></div>
<div class="container-fluid p-0 ">
  <div class="dashboard">
    <div class="container">
      <div class="d-sm-flex flex-sm-row ">
        <%= render 'home/dashboard/left_sidebar', marriage_profile: @marriage_profile %>
        <%# "Edit Profile" links here (#profile-details); the margin keeps it clear of the top bar %>
        <div class="right-section" id="profile-details" style="scroll-margin-top:72px;">
          <%= render 'home/dashboard/dashboard_tabs', marriage_profile: @marriage_profile %>
          <% profile_ad = Ad.for_profile_page %>
          <%= render 'marriage_profiles/marriage_profile_information', marriage_profile: @marriage_profile, profile_ad: profile_ad %>
          <%# Phones: the "Profile page" ad goes below the profile details (computers: beside the photos) %>
          <% if profile_ad %>
            <%= render 'shared/profile_page_ad', ad: profile_ad, extra_class: 'd-sm-none bk-profile-ad--inline' %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
