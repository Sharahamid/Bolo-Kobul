<%= form_for @marriage_profile, remote: true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: t('form.basic_information') %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">

      <% unless @marriage_profile.identification_document.present? %>
        <div class="form-group nid-input-field file-input-field">
          <div><%= profile_t('upload_id', @marriage_profile) %></div>
          <%= f.file_field :identification_document,
                           class: 'form-control sign_up-input-field',
                           data: {toggle: "tooltip", placement: "top"},
                           title: t('form.id_document') %>
          <div id="file-upload-filename"></div>
        </div>
      <% end %>

      <div class="form-group">
        <%= f.text_field :name,
                         class: 'form-control sign_up-input-field',
                         placeholder:profile_t('name', @marriage_profile),
                         title: profile_t('name_req', @marriage_profile),
                         data: {toggle:'tooltip', placement:'top'},
                         readonly: f.object.own_name_locked?,
                         required: true %>
        <small class="text-danger"> <%= f.object.errors[:name].present? ? f.object.errors.full_messages_for(:name).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.select :present_location,
                     options_for_select(district_options(District.order_by_name.pluck(:name)),
                      selected: @marriage_profile&.present_location),
                     {prompt: profile_t('present_location_req', @marriage_profile)},
                     class: 'form-control sign_up-input-field',
                     title: t('form.present_location_title'),
                     data: {toggle:'tooltip', placement:'top'},
                     required: true %>
        <small class="text-danger"> <%= f.object.errors[:present_location].present? ? f.object.errors.full_messages_for(:present_location).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.text_area :present_address,
                        placeholder: t('form.present_address_req'),
                        class: 'sign_up-input-field',
                        title: t('form.present_address_req'),
                        data: {toggle:'tooltip', placement:'top'},
                        style: "width: 100%",
                        rows: 3,
                        required: true %>
        <small class="text-danger"> <%= f.object.errors[:present_address].present? ? f.object.errors.full_messages_for(:present_address).first : '' %> </small>
      </div>

      <div class="form-group">
        <div class=" d-flex flex-row">
          <div class="flex-fill pr-1">
            <%= f.select :height_ft,
                         number_options(MarriageProfile::height_fts.filter { |k, v| k != '0' }),
                         {prompt: t('form.height_ft_req')},
                         autofocus: true,
                         autocomplete: "height_ft",
                         class: 'form-control sign_up-input-field',
                         placeholder: t('form.height_ft_req'),
                         required: true,
                         data: {toggle:'tooltip', placement:'top'},
                         title: t('form.height_ft_req') %>
            <small class="text-danger"> <%= f.object.errors[:height].present? ? f.object.errors.full_messages_for(:height).first : '' %> </small>
          </div>
          <div class="flex-fill pl-1">
            <%= f.select :height_inch,
                         number_options(MarriageProfile::height_inches),
                         {prompt: t('form.height_inch_req')},
                         autofocus: true,
                         autocomplete: "height_inch",
                         class: 'form-control sign_up-input-field',
                         required: true,
                         data: {toggle: "tooltip",
                         placement: "top"},
                         title: t('form.height_inch_req2') %>
            <small class="text-danger"> <%= f.object.errors[:height_inch].present? ? f.object.errors.full_messages_for(:height_inch).first : '' %> </small>
          </div>
        </div>
      </div>

      <div class="form-group">
        <%= f.select :highest_education_level,
                     enum_options(:marriage_profile, :highest_education_level, MarriageProfile::highest_education_levels.sort_by { |k, v| k == 'other' ? 'zzz' : k }.to_h.keys),
                     {prompt: profile_t('education_req', @marriage_profile)},
                     class: 'form-control sign_up-input-field',
                     required: true,
                     data: {toggle: "tooltip", placement: "top" },
                     title:t('form.education_title') %>
        <small class="text-danger"> <%= f.object.errors[:highest_education_level].present? ? f.object.errors.full_messages_for(:highest_education_level).first : '' %> </small>
      </div>
      <div class="form-group" id="other_education_field" style="display:none;">
        <%= f.text_field :other_education, placeholder: profile_t('specify_education', @marriage_profile), class: 'form-control sign_up-input-field', id: 'other_education_input' %>
      </div>

      <div class="form-group">
        <div class=" d-flex flex-row">
          <div class="flex-fill pr-1">
            <%= f.select :family_values,
                         enum_options(:marriage_profile, :family_values, MarriageProfile::family_values.filter { |k, v| k != 'does_not_matter'}.sort_by { |k, v| k }.to_h.keys),
                         {prompt: t('form.family_value')},
                         class: 'form-control sign_up-input-field',
                         data: {toggle: "tooltip", placement: "top"},
                         title: t('form.family_value') %>
            <small class="text-danger"> <%= f.object.errors[:family_values].present? ? f.object.errors.full_messages_for(:family_values).first : '' %> </small>
          </div>
          <div class="flex-fill pl-1">
            <%= f.select :family_type,
                         enum_options(:marriage_profile, :family_type, MarriageProfile::family_types.filter { |k, v| k != 'does_not_matter'}.sort_by { |k, v| k }.to_h.keys),
                         {prompt: t('form.family_type_req')}, class: 'form-control sign_up-input-field',
                         required: true,
                         data: {toggle: "tooltip", placement: "top"},
                         title: t('form.family_type') %>
            <small class="text-danger"> <%= f.object.errors[:family_type].present? ? f.object.errors.full_messages_for(:family_values).first : '' %> </small>
          </div>
        </div>
      </div>

      <div class="form-group">
        <%= f.fields_for :cultural_value, @marriage_profile.cultural_value || @marriage_profile.build_cultural_value do |cv| %>
          <%= cv.select :willing_to_relocate, yes_no_options,
                       {prompt: t('form.willing_to_relocate')},
                       class: 'form-control sign_up-input-field',
                       title: t('form.willing_to_relocate'),
                       data: {toggle: 'tooltip', placement:'top'}
          %>
          <small class="text-danger"> <%= cv.object.errors[:willing_to_relocate].present? ? cv.object.errors.full_messages_for(:willing_to_relocate).first : '' %> </small>
        <% end %>
      </div>
      <div class="form-group">
        <div class="d-flex flex-row">
          <div class="flex-fill pr-1">
            <%= f.select :marital_status,
                         enum_options(:marriage_profile, :marital_status, MarriageProfile::marital_statuses.reject { |k, v| k == "married" }.sort_by { |k, v| k }.to_h.keys),
                         {prompt: t('form.marital_status')}, class: 'form-control sign_up-input-field',
                         data: {toggle: "tooltip", placement: "top"},
                         title: t('form.marital_status') %>
            <small class="text-danger"> <%= f.object.errors[:marital_status].present? ? f.object.errors.full_messages_for(:marital_status).first : '' %> </small>
          </div>
        </div>
          <div class="flex-fill pl-1">
            <%= f.select :family_status,
                         enum_options(:marriage_profile, :family_status, MarriageProfile::family_statuses.filter { |k, v| k != 'does_not_matter'}.sort_by { |k, v| k }.to_h.keys),
                         {prompt: t('form.family_status')},
                         class: 'form-control sign_up-input-field',
                         data: {toggle: "tooltip",
                                placement: "top"},
                         title: t('form.family_status') %>
            <small class="text-danger"> <%= f.object.errors[:family_status].present? ? f.object.errors.full_messages_for(:family_status).first : '' %> </small>
          </div>
        </div>
      </div>

    </div>
  </div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var eduSelect = document.querySelector('select[name="marriage_profile[highest_education_level]"]');
  if (eduSelect) {
    eduSelect.addEventListener('change', function() {
      var field = document.getElementById('other_education_field');
      var input = document.getElementById('other_education_input');
      if (this.value === 'other') {
        field.style.display = 'block';
        input.required = true;
      } else {
        field.style.display = 'none';
        input.required = false;
        input.value = '';
      }
    });
    // Show on load if already set to other
    if (eduSelect.value === 'other') {
      document.getElementById('other_education_field').style.display = 'block';
    }
  }
});
</script>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>
