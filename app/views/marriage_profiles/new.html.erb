<div class="container-fluid p-0">
  <div class="container">
    <div class="basic_info">
      <div class="basic-info-mandala">
        <%= image_tag 'mandala.svg', class: 'img-responsive' %>
      </div>
      <div class="d-flex flex-column align-items-center">
        <div class="internal_form_heading align-self-center text-center">
          <span style="display:block; width:41px; height:4px; background:#FFB627; margin:0 auto 6px;"></span>
          <h1 style="font-size:20px; font-weight:700; color:#1a1a1a; margin:0;"><%= profile_t('heading', @marriage_profile) %></h1>
        </div>
        <div class="form_title align-self-start pt-3 pl-2 pr-2">
          <strong> <%= t('form.basics') %> </strong> <br>
          <%= image_tag 'yellow_line.svg', width: '51.59', height: '17' %>
        </div>
	<div class="alert mt-2 mb-3" role="alert" style="font-size:0.95rem; background-color: rgb(255,182,39); color:white; border:none;">
          <%= profile_t('privacy_note', @marriage_profile) %>
	</div>
        <div class="form_input_fields pt-4 pl-2 pr-2">
          <%= form_for @marriage_profile do |f| %>

            <div class="form-group">
              <%= f.text_field :name,
                               autofocus: true,
                               autocomplete: f.object.own_name_locked? ? "name" : "off",
                               class: 'form-control sign_up-input-field',
                               placeholder: profile_t('full_name', @marriage_profile),
                               required: true,
                               readonly: f.object.own_name_locked?,
                               data: {toggle: "tooltip", placement: "top" },
                               title: profile_t('full_name', @marriage_profile) %>
              <% if f.object.own_name_locked? %>
                <small class="form-text text-muted"><%= t('form.registered_name') %></small>
              <% end %>
              <small class="text-danger"> <%= f.object.errors[:name].present? ? f.object.errors[:name]&.first : '' %> </small>
            </div>

            <div class="form-group">
              <%= f.text_field :nid_or_passport,
                               autocomplete: "nid_or_passport",
                               class: 'form-control sign_up-input-field',
                               placeholder: profile_t('nid', @marriage_profile),
                               minlength: '6',
                               data: {toggle: "tooltip", placement: "top" },
                               title: profile_t('nid_title', @marriage_profile) %>
              <small class="text-danger"> <%= f.object.errors[:nid_or_passport].present? ? f.object.errors[:nid_or_passport]&.first : '' %> </small>
            </div>

            <div class="form-group">
              <div><%= profile_t('upload_id', @marriage_profile) %></div>
              <%= f.file_field :identification_document, required: true,
                               class: 'form-control sign_up-input-field',
                               style: 'padding: 3px',
                               data: {toggle: "tooltip", placement: "top" },
                               title: t('form.id_types') %>
              <small class="text-danger">
                <%= f.object.errors[:identification_document].present? ? f.object.errors[:identification_document]&.first : '' %>
              </small>
            </div>

            <div class="form-group">
              <%= f.select :gender,
                           enum_options(:marriage_profile, :gender, MarriageProfile::genders.sort_by { |k, v| k }.to_h.keys),
                           {prompt: profile_t('gender_req', @marriage_profile)},
                           required: true,
                           class: 'form-control sign_up-input-field',
                           data: {toggle: "tooltip", placement: "top" },
                           title: profile_t('gender_lock', @marriage_profile) %>
              <small class="text-danger"> <%= f.object.errors[:gender].present? ? f.object.errors[:gender]&.first : '' %> </small>
            </div>
            <div class="form-group" id="other_gender_field" style="display:none;">
              <%= f.text_field :other_gender, placeholder: profile_t('specify_gender', @marriage_profile), class: 'form-control sign_up-input-field', id: 'other_gender_input' %>
            </div>

            <div class="form-group">
	      <%= f.label :date_of_birth, profile_t('date_of_birth', @marriage_profile), class: "form-label" %>
              <%= f.date_field :date_of_birth,
                               max: Date.today.years_ago(18),
                               autofocus: true,
                               class: 'form-control sign_up-input-field',
                               title:profile_t('dob_title', @marriage_profile),
                               required: true,
			       placeholder: profile_t('dob_placeholder', @marriage_profile),   # behaves like prompt
                               data: {toggle: "tooltip", placement: "top" } %>
              <small class="text-danger"> <%= f.object.errors[:date_of_birth].present? ? f.object.errors[:date_of_birth]&.first : '' %> </small>
            </div>

	    <div class="form-group">
              <%= f.select :marital_status,
                           enum_options(:marriage_profile, :marital_status, MarriageProfile::marital_statuses.reject { |k, v| k == "married" }.sort_by { |k, v| k }.to_h.keys),
                           {prompt: profile_t('marital_status_req', @marriage_profile)},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top"},
                           title: t('form.marital_status') %>
              <small class="text-danger"> <%= f.object.errors[:marital_status].present? ? f.object.errors[:marital_status]&.first : '' %> </small>
            </div>

            <div class="form-group">
              <%= f.select :religion,
                           enum_options(:marriage_profile, :religion, MarriageProfile::religions.sort_by { |k, v| k }.to_h.keys),
                           {prompt: profile_t('religion_req', @marriage_profile)},
                           required: true,
                           class: 'form-control sign_up-input-field',
                           data: {toggle: "tooltip", placement: "top" },
                           title:t('form.religion') %>
              <small class="text-danger"> <%= f.object.errors[:religion].present? ? f.object.errors[:religion]&.first : '' %> </small>
            </div>
            <div class="form-group" id="other_religion_field" style="display:none;">
              <%= f.text_field :other_religion, placeholder: profile_t('specify_religion', @marriage_profile), class: 'form-control sign_up-input-field', id: 'other_religion_input' %>
            </div>

            <div class="form-group">
              <%= f.select :hometown,
                           district_options(District.order_by_name.pluck(:name)),
                           {prompt: profile_t('hometown_req', @marriage_profile)},
                           class: 'form-control sign_up-input-field',
                           required: true,
			   placeholder: profile_t('dob_placeholder', @marriage_profile),   # behaves like prompt
                           data: {toggle: "tooltip", placement: "top" },
                           title:profile_t('hometown_title', @marriage_profile) %>
              <small class="text-danger"> <%= f.object.errors[:hometown].present? ? f.object.errors[:hometown]&.first : '' %> </small>
            </div>
	    <div id="hometown_abroad_fields" class="mb-3" style="display:none;">
              <div class="row mt-2">
                <div class="col-6">
		  <%= f.select :hometown_country, options_for_select(Country.order(:name).pluck(:name), f.object.hometown_country), {prompt: t('form.country_req')}, class: 'form-control sign_up-input-field', id: 'hometown_country_input' %>
                </div>
                <div class="col-6">
                  <%= f.text_field :hometown_city, placeholder: t('form.city_req'), class: 'form-control sign_up-input-field', id: 'hometown_city_input' %>
                </div>
              </div>
            </div>

            <div class="form-group">
              <%= f.select :present_location,
                           district_options(District.order_by_name.pluck(:name)), {prompt: profile_t('present_location_req', @marriage_profile)},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top" },
                           title:profile_t('present_location_req', @marriage_profile) %>
              <small class="text-danger"> <%= f.object.errors[:present_location].present? ? f.object.errors[:present_location]&.first : '' %> </small>
            </div>
	    <div id="present_location_abroad_fields" class="mb-3" style="display:none;">
              <div class="row mt-2">
                <div class="col-6">
		  <%= f.select :present_location_country, options_for_select(Country.order(:name).pluck(:name), f.object.present_location_country), {prompt: t('form.country_req')}, class: 'form-control sign_up-input-field', id: 'present_location_country_input' %>
                </div>
                <div class="col-6">
                  <%= f.text_field :present_location_city, placeholder: t('form.city_req'), class: 'form-control sign_up-input-field', id: 'present_location_city_input' %>
                </div>
              </div>
            </div>

            <div class="form-group">
              <div class=" d-flex flex-row">
                <div class="flex-fill pr-1">
                  <%= f.select :height_ft,
                               number_options(MarriageProfile::height_fts.filter { |k, v| k != '0' }),
                               {prompt: profile_t('height_ft_req', @marriage_profile)},
                               autofocus: true,
                               autocomplete: "height",
                               class: 'form-control sign_up-input-field',
                               placeholder: profile_t('height_ft_req', @marriage_profile),
                               required: true,
                               data: {toggle: "tooltip", placement: "top" },
                               title:t('form.height_ft') %>
                  <small class="text-danger"> <%= f.object.errors[:height].present? ? f.object.errors[:height]&.first : '' %> </small>
                </div>
                <div class="flex-fill pl-1">
                  <%= f.select :height_inch,
                               number_options(MarriageProfile::height_inches),
                               {prompt: profile_t('height_inch_req', @marriage_profile)},
                               autofocus: true,
                               autocomplete: "height_inch",
                               class: 'form-control sign_up-input-field',
                               required: true,
                               data: {toggle: "tooltip", placement: "top" },
                               title:t('form.height_inch') %>
                  <small class="text-danger"> <%= f.object.errors[:height_inch].present? ? f.object.errors[:height_inch]&.first : '' %> </small>
                </div>
              </div>
            </div>

            <div class="form-group">
              <%= f.select :highest_education_level,
                           enum_options(:marriage_profile, :highest_education_level, MarriageProfile::highest_education_levels.sort_by { |k, v| k == 'other' ? 'zzz' : k }.to_h.keys),
                           {prompt: profile_t('education_req', @marriage_profile)},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top" },
                           title:t('form.education_title') %>
              <small class="text-danger"> <%= f.object.errors[:highest_education_level].present? ? f.object.errors[:highest_education_level]&.first : '' %> </small>
            </div>
            <div class="form-group" id="other_education_field" style="display:none;">
              <%= f.text_field :other_education, placeholder: profile_t('specify_education', @marriage_profile), class: 'form-control sign_up-input-field', id: 'other_education_input' %>
            </div>

            <div class="form-group">
              <%= f.select :family_type,
                           enum_options(:marriage_profile, :family_type, MarriageProfile::family_types.filter { |k, v| k != 'does_not_matter'}.sort_by { |k, v| k }.to_h.keys),
                           {prompt: t('form.family_type_req')},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top"},
                           title: t('form.family_type') %>
              <small class="text-danger"> <%= f.object.errors[:family_type].present? ? f.object.errors[:family_values]&.first : '' %> </small>
            </div>

            <div class="form-group">
              <%= f.select :family_status,
                           enum_options(:marriage_profile, :family_status, MarriageProfile::family_statuses.filter { |k, v| k != 'does_not_matter' }.sort_by { |k, v| k }.to_h.keys),
                           {prompt: t('form.family_status_req')},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top"},
                           title: t('form.family_status') %>
              <small class="text-danger"> <%= f.object.errors[:family_status].present? ? f.object.errors[:family_status]&.first : '' %> </small>
            </div>
            <div class="form-group">
              <%= f.select :family_values,
                           enum_options(:marriage_profile, :family_values, MarriageProfile::family_values.filter { |k, v| k != 'does_not_matter' }.sort_by { |k, v| k }.to_h.keys),
                           {prompt: t('form.family_values_req')},
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top"},
                           title: t('form.family_values') %>
              <small class="text-danger"> <%= f.object.errors[:family_values].present? ? f.object.errors[:family_values]&.first : '' %> </small>
            </div>

            <div class="form-group">
              <%= f.select :blood_group,
                           MarriageProfile::blood_groups.sort_by { |k, v| k }.to_h.map { |k, v| [k, k] },
                           {prompt: profile_t('blood_group_req', @marriage_profile)},
                           autofocus: true,
                           class: 'form-control sign_up-input-field',
                           required: true,
                           data: {toggle: "tooltip", placement: "top" },
                           title:profile_t('blood_group_lock', @marriage_profile) %>
              <small class="text-danger"> <%= f.object.errors[:blood_group].present? ? f.object.errors[:blood_group]&.first : '' %> </small>
            </div>

            <div class="register-btn-section text-center">
              <button type="submit" class="btn btn-sign_up form-control"> <%= t('form.next') %></button>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<script>
document.addEventListener('DOMContentLoaded', function() {
  function setupOtherField(selectName, fieldId, inputId, triggerValue) {
    triggerValue = triggerValue || 'other';
    var select = document.querySelector('select[name="marriage_profile[' + selectName + ']"]');
    var field = document.getElementById(fieldId);
    var input = document.getElementById(inputId);
    if (!select || !field) return;
    function toggle() {
      if (select.value === triggerValue) {
        field.style.display = 'block';
        input.required = true;
      } else {
        field.style.display = 'none';
        input.required = false;
      }
    }
    select.addEventListener('change', toggle);
    toggle();
  }
  setupOtherField('gender', 'other_gender_field', 'other_gender_input');
  setupOtherField('religion', 'other_religion_field', 'other_religion_input');
  setupOtherField('highest_education_level', 'other_education_field', 'other_education_input');
  setupOtherField('hometown', 'hometown_abroad_fields', 'hometown_country_input', 'Outside Bangladesh');
  setupOtherField('present_location', 'present_location_abroad_fields', 'present_location_country_input', 'Outside Bangladesh');
  // Make city fields required too when Outside Bangladesh is selected
  (function() {
    ['hometown', 'present_location'].forEach(function(field) {
      var select = document.querySelector('select[name="marriage_profile[' + field + ']"]');
      var cityInput = document.getElementById(field + '_city_input');
      if (!select || !cityInput) return;
      function toggleCity() {
        cityInput.required = select.value === 'Outside Bangladesh';
      }
      select.addEventListener('change', toggleCity);
      toggleCity();
    });
  })();
});
</script>
</div>
