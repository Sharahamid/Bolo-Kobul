<%= form_for @marriage_profile, url: update_about_marriage_profile_path(@marriage_profile), method: :patch, remote: true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: profile_t('about_yourself', @marriage_profile) %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">
      <div class="form-group">
        <%= f.text_area :about_my_self,
                        autofocus: true,
                        autocomplete: "about_my_self",
                        class: 'form-control sign_up-input-field',
                        placeholder: profile_t('about_placeholder', @marriage_profile),
                        title: profile_t('about_myself', @marriage_profile),
                        data: {toggle: 'tooltip', placement:'top'},
                        required: true %>
      </div>


      <div class="form-group">
        <%= f.text_area :special_circumstances,
                        placeholder: t('form.special_circumstances'),
                        title: t('form.special_circumstances'),
                        data: {toggle: 'tooltip',
                               placement: 'top'},
                        class: 'form-control sign_up-input-field' %>
        <small class="text-danger"> <%= f.object.errors[:special_circumstances].present? ? f.object.errors.full_messages_for(:special_circumstances).first : '' %> </small>
      </div>

      <div class="">
        <%= f.text_area :description,
                        placeholder: profile_t('about_family', @marriage_profile),
                        title: profile_t('about_family', @marriage_profile),
                        data: {toggle: 'tooltip',
                               placement: 'top'},
                        class: 'form-control sign_up-input-field' %>
        <small class="text-danger"> <%= f.object.errors[:description].present? ? f.object.errors.full_messages_for(:description).first : '' %> </small>
      </div>

    </div>
  </div>
  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>