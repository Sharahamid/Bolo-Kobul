<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr><td align="center" style="padding: 2rem 1rem;">
<table width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%;">

  <tr><td style="background:#ffffff; border-radius:8px 8px 0 0; text-align:center; padding: 2rem 2rem 1rem;">
    <img src="https://bolokobul.com/email/bk_logo.png" width="80" style="margin-bottom:10px;" alt="Bolo Kobul" />
    <div style="font-size:11px; color:#888;<%= ' letter-spacing:2px; text-transform:uppercase;' unless I18n.locale == :bn %>"><%= t('email.tagline') %></div>
    <div style="width:40px; height:2px; background:#FFB627; margin:12px auto 0;"></div>
  </td></tr>

  <tr><td style="background:#412402; padding: 2rem; text-align:center;">
    <div style="font-size:30px;">👑</div>
    <div style="font-size:22px; font-weight:bold; color:#FFB627; line-height:1.3; margin-top:8px;">
      <%= t(@renewal ? 'email.bk_plus.title_extended' : 'email.bk_plus.title_welcome') %>
    </div>
    <div style="font-size:14px; color:#FAC775; margin-top:8px;"><%= t('email.dear', name: @user.name.presence || t('email.member')) %></div>
  </td></tr>

  <tr><td style="background:#ffffff; padding: 2rem;">
    <p style="font-size:15px; color:#333333; line-height:1.8; margin:0 0 1.5rem;">
      <%= t(@renewal ? 'email.bk_plus.p1_extended' : 'email.bk_plus.p1_welcome') %>
    </p>

    <div style="background:#FFF8E7; border:1px solid #FFE082; border-radius:6px; padding:16px; margin-bottom:1.75rem;">
      <table width="100%" cellpadding="0" cellspacing="0">
        <% if @plan %>
        <tr>
          <td style="font-size:13px; color:#555555; padding:4px 0; width:190px;"><%= t('email.bk_plus.plan') %></td>
          <td style="font-size:14px; color:#333333; padding:4px 0; font-weight:bold;">: BK+ <%= @plan.label %></td>
        </tr>
        <% end %>
        <% if @until %>
        <tr>
          <td style="font-size:13px; color:#555555; padding:4px 0;"><%= t('email.bk_plus.valid_until') %></td>
          <td style="font-size:14px; color:#333333; padding:4px 0; font-weight:bold;">: <%= email_date(@until.to_date) %></td>
        </tr>
        <% end %>
        <% if @plan && @plan.butterflies.to_i > 0 %>
        <tr>
          <td style="font-size:13px; color:#555555; padding:4px 0;"><%= t('email.bk_plus.bonus') %></td>
          <td style="font-size:14px; color:#333333; padding:4px 0; font-weight:bold;">: 🦋 <%= local_digits(@plan.butterflies) %></td>
        </tr>
        <% end %>
      </table>
    </div>

    <div style="font-size:16px; font-weight:bold; color:#412402; margin-bottom:12px;"><%= t('email.bk_plus.features_title') %></div>
    <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:1.75rem;">
      <% [['🏅', 1], ['⭐', 2], ['💞', 6], ['👀', 3], ['💛', 4], ['🦋', 5]].each do |icon, n| %>
      <tr>
        <td valign="top" style="width:44px; padding:8px 0;">
          <div style="width:34px; height:34px; line-height:34px; border-radius:50%; background:#FFF3D6; text-align:center; font-size:17px;"><%= icon %></div>
        </td>
        <td valign="top" style="padding:8px 0 8px 6px;">
          <div style="font-size:14px; font-weight:bold; color:#333333;"><%= t("email.bk_plus.f#{n}_title") %></div>
          <div style="font-size:13px; color:#666666; line-height:1.6; margin-top:2px;"><%= t("email.bk_plus.f#{n}_text") %></div>
        </td>
      </tr>
      <% end %>
    </table>

    <div style="text-align:center; margin-bottom:12px;">
      <a href="<%= bk_plus_viewed_you_url %>" style="background:#FFB627; color:#ffffff; text-decoration:none; padding:14px 36px; border-radius:6px; font-size:15px; font-weight:bold; display:inline-block;"><%= t('email.bk_plus.button') %></a>
    </div>
    <div style="text-align:center; margin-bottom:1.75rem;">
      <a href="<%= bk_plus_saved_you_url %>" style="color:#854F0B; font-size:14px; font-weight:bold;"><%= t('email.bk_plus.saved_link') %></a>
    </div>

    <div style="background:#f9f9f9; border:1px solid #eeeeee; border-radius:6px; padding:14px 16px; margin-bottom:1rem;">
      <div style="font-size:13px; color:#555555; line-height:1.7;">
        <strong style="color:#333333;"><%= t('email.bk_plus.note_title') %></strong> <%= t('email.bk_plus.note') %>
        <a href="<%= bk_plus_url %>" style="color:#FFB627; font-weight:bold;"><%= t('email.bk_plus.more_days') %></a>
      </div>
    </div>

    <p style="font-size:14px; color:#555555; line-height:1.8; margin:0;">
      <%= t('email.receipt.questions_html', email: mail_to('support@bolokobul.com', 'support@bolokobul.com', style: 'color:#FFB627;'), whatsapp: link_to('+8801611820410', 'https://wa.me/8801611820410', style: 'color:#FFB627;')) %>
    </p>
  </td></tr>

  <tr><td style="background:#FFF8E7; padding:1.5rem 2rem; text-align:center; border-top:1px solid #FFE082;">
    <div style="font-size:14px; color:#888888; line-height:1.8;"><%= t('email.warm_wishes') %></div>
    <div style="font-size:15px; font-weight:bold; color:#FFB627; margin-top:4px;"><%= t('email.team') %></div>
    <div style="font-size:11px; color:#aaaaaa; margin-top:12px;">
      <a href="https://bolokobul.com" style="color:#FFB627; text-decoration:none;">bolokobul.com</a> &nbsp;|&nbsp;
      <a href="mailto:support@bolokobul.com" style="color:#FFB627; text-decoration:none;">support@bolokobul.com</a> &nbsp;|&nbsp;
      <a href="https://wa.me/8801611820410" style="color:#FFB627; text-decoration:none;">WhatsApp</a> &nbsp;|&nbsp;
      <a href="https://fb.com/bolokobulltd" style="color:#FFB627; text-decoration:none;">Facebook</a>
    </div>
  </td></tr>

</table>
</td></tr>
</table>
</body>
</html>
