<div class="bk-social-signup">
  <div class="bk-social-signup__card">
    <div class="bk-social-signup__icon">🦋</div>
    <h4><%= t('social_signup.title') %></h4>
    <p class="bk-social-signup__lead"><%= t('social_signup.lead_html', provider: content_tag(:strong, SocialLogin.label(@data['provider'])), email: content_tag(:strong, @data['email'])) %><br><%= t('social_signup.lead2') %></p>

    <%= form_for @user, url: social_signup_path, method: :post, html: { 'data-turbolinks' => 'false' } do |f| %>
      <% if @user.errors.any? %>
        <div class="bk-social-signup__errors">
          <% @user.errors.full_messages.reject { |m| m.start_with?('Password') }.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <label for="user_name"><%= t('social_signup.full_name') %></label>
      <%= f.text_field :name, required: true, autocomplete: 'name', class: 'form-control' %>

      <label for="user_phone_number"><%= t('social_signup.mobile') %></label>
      <%= f.phone_field :phone_number, required: true, autocomplete: 'tel', class: 'form-control', placeholder: '+8801XXXXXXXXX', autofocus: true %>

      <label for="user_created_for"><%= t('social_signup.created_for') %></label>
      <%= f.select :created_for, options_for_select(User.created_fors.keys.map { |k| [enum_label(:user, :created_for, k), k] }, @user.created_for),
                   { prompt: t('social_signup.choose') }, class: 'form-control', required: true %>

      <label class="bk-social-signup__terms">
        <input type="checkbox" required>
        <span><%= t('social_signup.terms_html', terms: link_to(t('signup.terms_of_use'), terms_of_uses_path, target: '_blank'), privacy: link_to(t('signup.privacy_policy'), privacy_policies_path, target: '_blank')) %></span>
      </label>

      <%= f.submit t('social_signup.continue'), class: 'bk-social-signup__submit' %>
    <% end %>
    <p class="bk-social-signup__note"><i class="fas fa-lock"></i> <%= t('social_signup.note') %></p>
  </div>
</div>
