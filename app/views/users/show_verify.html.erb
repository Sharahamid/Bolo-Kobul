<div class="container mt-5">
  <div class="basic_info">
    <div class="basic-info-mandala">
      <%= image_tag 'mandala.svg', class: 'img-responsive' %>
    </div>
    <div class="d-flex flex-column align-items-center">
      <div class="form_title align-self-start pt-3 pl-2 pr-2">
        <% if @user.phone_number.to_s.start_with?('+880', '01', '008801') %>
          <strong><%= t('verify.title_phone') %></strong>
        <% else %>
          <strong><%= t('verify.title_account') %></strong>
        <% end %>
        <br>
        <%= image_tag 'yellow_line.svg', width: '51.59', height: '17' %>
      </div>
      <div class="form_input_fields pt-4 pl-2 pr-2">
        <% if @user.phone_number.to_s.start_with?('+880', '01', '008801') %>
          <p>
            <%= t('verify.sent_phone_html', number: content_tag(:strong, "#{@user.phone_number.to_s[0...3]}.....#{@user.phone_number.to_s[-2..-1]}")) %>
          </p>
        <% else %>
          <p>
            <%= t('verify.sent_email_html', email: content_tag(:strong, @user.email.to_s.gsub(/(?<=.{2})[^@](?=.*@)/, '*'))) %>
          </p>
        <% end %>
        <%= form_tag verify_user_path(@user) do %>
          <div class="form-group">
            <%= label_tag :token, t('verify.code_label') %>
            <%= text_field_tag :token, '', class: "form-control", placeholder: t('verify.code_placeholder') %>
          </div>
          <button type="submit" class="btn btn-primary"><%= t('verify.verify') %></button>
          &nbsp;
          <%# A real button (not a scripted link), so it works on every phone even if JavaScript fails %>
          <button type="submit" class="btn btn-link px-1" formaction="<%= resend_user_path(@user) %>" formmethod="post" formnovalidate><%= t('verify.resend') %></button>
        <% end -%>
        <p class="mt-3" style="font-size:13px; color:#888;">
          <%= t('verify.help_html', resend: content_tag(:strong, t('verify.resend')), email: mail_to('support@bolokobul.com')) %>
        </p>
      </div>
    </div>
  </div>
</div>
