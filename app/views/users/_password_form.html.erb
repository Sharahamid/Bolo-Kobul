<%= form_for @user, url: update_password_user_path(@user), method: :patch do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: t('password.change') %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">

      <div class="form-group">
        <%= f.password_field :current_password,
                             autofocus: true,
                             class: 'form-control sign_up-input-field',
                             placeholder: t('password.current'),
                             required: true,
                             data: {toggle: "tooltip", placement: "top"},
                             title: t('password.current_hint') %>
      </div>

      <div class="form-group">
        <%= f.password_field :password,
                             minlength: '8',
                             maxlength: '128',
                             pattern: "(?=.*[A-Za-z])(?=.*\\d).{8,}",
                             autofocus: true,
                             autocomplete: "password",
                             class: 'form-control sign_up-input-field',
                             placeholder: t('password.new'),
                             required: true,
                             data: {toggle: "tooltip", placement: "top"},
                             title: t('signup.password_rule')
        %>
        <% if @minimum_password_length %>
          <em><%= t('password.minimum', count: local_digits(@minimum_password_length)) %></em>
        <% end %>
      </div>

      <div class="form-groupx">
        <%= f.password_field :password_confirmation,
                             autocomplete: "off",
                             class: 'form-control sign_up-input-field',
                             placeholder: t('password.confirm_new'),
                             required: true,
                             data: {toggle: "tooltip", placement: "top"},
                             title: t('password.confirm_new') %>
      </div>

    </div>
  </div>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>