<%= form_for life_style, remote: true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: t('section_form.life_style') %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">

      <div class="form-group">
        <%= f.select :drinker,
                     choice_options(:drink_smoke_data),
                     {prompt: t('section_form.do_you_drink')},
                     title: t('section_form.do_you_drink'),
                     data: {toggle: 'tooltip', placement: 'top'},
                     class: 'form-control sign_up-input-field' %>
        <small class="text-danger">
          <%= f.object.errors[:drinker].present? ? f.object.errors.full_messages_for(:drinker).first : '' %>
        </small>
      </div>

      <div class="form-group">
        <%= f.select :smoker, choice_options(:drink_smoke_data), {prompt: t('section_form.do_you_smoke')},
                     title: t('section_form.do_you_smoke'),
                     data: {toggle: 'tooltip', placement: 'top'},
                     class: 'form-control sign_up-input-field' %>
        <small class="text-danger">
          <%= f.object.errors[:smoker].present? ? f.object.errors.full_messages_for(:smoker).first : '' %>
        </small>
      </div>

      <div class="form-group">
        <%= f.select :food_habits,
                     choice_options(:food_habits),
                     {prompt: t('section_form.food_habits')},
                     title: t('section_form.food_habits'),
                     data: {toggle: 'tooltip', placement: 'top'},
                     class: 'form-control sign_up-input-field' %>
        <small class="text-danger">
          <%= f.object.errors[:food_habits].present? ? f.object.errors.full_messages_for(:food_habits).first : '' %>
        </small>
      </div>

      <div class="form-group">
        <%= f.label :dress_style, t('section_form.dress_style') %><br/>
        <div class="d-sm-flex flex-sm-row flex-wrap">
          <% User::DRESS_STYLE.each do |value, id| %>
            <label class="check-box-lbl-item">
              <%= check_box_tag "life_style[dress_style][]",
                                id ,
                                checked_dress_style(id)%>
              <span class="ck-box-lbl" title="<%= choice_label(:dress_style, value) %>" data-toggle='tooltip' data-placement="top">
              <%= choice_label(:dress_style, value) %>
              </span>
            </label>
          <% end %>
        </div>

      </div>

      <div class="form-group">
        <%= f.label :living_with, t('section_form.living_with') %><br/>
        <div class="d-sm-flex flex-sm-row flex-wrap">
          <% User::LIVING_WITH.each do |value, id| %>
            <label class="check-box-lbl-item">
              <%= check_box_tag "life_style[living_with][]",
                                id,
                                checked_living_with(id) %>
              <span class="ck-box-lbl" title="<%= choice_label(:living_with, value) %>" data-toggle='tooltip' data-placement="top">
              <%= choice_label(:living_with, value) %>
              </span>
            </label>
          <% end %>
        </div>
      </div>

      <div>
        <%= f.text_area :specific_habits,
                        class: 'form-control',
                        placeholder: t('section_form.any_specific_habits_you_want_to_share'),
                        title: t('section_form.any_specific_habits_you_want_to_share'),
                        data: {toggle: 'tooltip', placement: 'top'}
        %>
      </div>


    </div>
  </div>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>