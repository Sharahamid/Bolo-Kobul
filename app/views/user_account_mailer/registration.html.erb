<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0">
<tr><td align="center" style="padding: 2rem 1rem;">

<table width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%;">

  <tr><td style="background:#ffffff; border-radius:8px 8px 0 0; text-align:center; padding: 2rem 2rem 1rem;">
    <img src="https://www.bolokobul.com/assets/bk_logo-d410475b2bfdeb425af379c0193908b7a02336b47f98b379e58edd6ba21c8435.png" width="80" style="margin-bottom:10px;" alt="Bolo Kobul" />
    <div style="font-size:11px; color:#888;<%= ' letter-spacing:2px; text-transform:uppercase;' unless I18n.locale == :bn %>"><%= t('email.tagline') %></div>
    <div style="width:40px; height:2px; background:#FFB627; margin:12px auto 0;"></div>
  </td></tr>

  <tr><td style="background:#FFB627; padding: 2rem; text-align:center;">
    <div style="font-size:26px; font-weight:bold; color:#ffffff; line-height:1.3;">
      <%= t('email.welcome.title') %><br>
      <%= t('email.dear_welcome', name: @user.name.presence || t('email.welcome.friend')) %>
    </div>
    <div style="font-size:14px; color:#fff3cc; margin-top:10px;"><%= t('email.welcome.sub') %></div>
  </td></tr>

  <tr><td style="background:#ffffff; padding: 2rem;">
    <p style="font-size:15px; color:#333333; line-height:1.8; margin:0 0 1rem;">
      <%= t('email.welcome.p1') %>
    </p>
    <p style="font-size:15px; color:#333333; line-height:1.8; margin:0 0 1.5rem;">
      <%= t('email.welcome.p2') %>
    </p>

    <table width="100%" cellpadding="0" cellspacing="0">
      <tr>
        <td width="48" valign="top" style="padding: 0 12px 16px 0;">
          <div style="width:36px; height:36px; background:#FFF3CC; border-radius:50%; text-align:center; line-height:36px; font-weight:bold; color:#FFB627; font-size:16px;">1</div>
        </td>
        <td valign="top" style="padding-bottom:16px;">
          <div style="font-size:14px; font-weight:bold; color:#333333;"><%= t('email.welcome.s1') %></div>
          <div style="font-size:13px; color:#666666; margin-top:3px;"><%= t('email.welcome.s1_text') %></div>
        </td>
      </tr>
      <tr>
        <td width="48" valign="top" style="padding: 0 12px 16px 0;">
          <div style="width:36px; height:36px; background:#FFF3CC; border-radius:50%; text-align:center; line-height:36px; font-weight:bold; color:#FFB627; font-size:16px;">2</div>
        </td>
        <td valign="top" style="padding-bottom:16px;">
          <div style="font-size:14px; font-weight:bold; color:#333333;"><%= t('email.welcome.s2') %></div>
          <div style="font-size:13px; color:#666666; margin-top:3px;"><%= t('email.welcome.s2_text') %></div>
        </td>
      </tr>
      <tr>
        <td width="48" valign="top" style="padding: 0 12px 0 0;">
          <div style="width:36px; height:36px; background:#FFF3CC; border-radius:50%; text-align:center; line-height:36px; font-weight:bold; color:#FFB627; font-size:16px;">3</div>
        </td>
        <td valign="top">
          <div style="font-size:14px; font-weight:bold; color:#333333;"><%= t('email.welcome.s3') %></div>
          <div style="font-size:13px; color:#666666; margin-top:3px;"><%= t('email.welcome.s3_text') %></div>
        </td>
      </tr>
    </table>

    <div style="text-align:center; margin: 2rem 0;">
      <a href="https://www.bolokobul.com" style="background:#FFB627; color:#ffffff; text-decoration:none; padding:14px 36px; border-radius:6px; font-size:15px; font-weight:bold; display:inline-block;"><%= t('email.welcome.button') %></a>
    </div>

    <div style="background:#FFF8E7; border-left:3px solid #FFB627; padding:14px 16px; margin-bottom:1.5rem;">
      <div style="font-size:13px; color:#555555; line-height:1.7;">
        <strong style="color:#333333;"><%= t('email.welcome.privacy') %></strong> <%= t('email.welcome.privacy_text') %>
      </div>
    </div>

    <p style="font-size:14px; color:#555555; line-height:1.8; margin:0;">
      <%= t('email.welcome.help') %>
    </p>
  </td></tr>

  <tr><td style="background:#FFF8E7; padding:1.5rem 2rem; text-align:center; border-top:1px solid #FFE082;">
    <div style="font-size:14px; color:#888888; line-height:1.8;"><%= t('email.warm_wishes') %></div>
    <div style="font-size:15px; font-weight:bold; color:#FFB627; margin-top:4px;"><%= t('email.team') %></div>
    <div style="margin-top:16px;">
      <%= render 'shared/email_social_icons' %>
    </div>
    <div style="font-size:10px; color:#cccccc; margin-top:10px;">
      <%= t('email.follow_html') %>
    </div>
    <div style="font-size:12px; color:#aaaaaa; margin-top:12px;">
      Bolo Kobul &nbsp;|&nbsp; <a href="https://www.bolokobul.com" style="color:#FFB627; text-decoration:none;">bolokobul.com</a><br><br>
      <span style="font-size:11px;"><%= t('email.welcome.why_html', contact: mail_to('support@bolokobul.com', t('email.welcome.contact_us'), style: 'color:#FFB627;')) %></span>
    </div>
  </td></tr>

</table>

</td></tr>
</table>

</body>
</html>
