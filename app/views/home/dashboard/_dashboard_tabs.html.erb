<style>
.dashboard-header .nav-link { display:flex !important; flex-direction:column !important; align-items:center !important; justify-content:center !important; gap:3px !important; font-size:13px !important; }
.dashboard-header .nav-link i { font-size:18px !important; }
/* Phones: an even grid of two lines (3 + 2, centred), each icon above its label */
@media (max-width: 575.98px) {
  .dashboard-header { display:flex !important; flex-wrap:wrap !important; justify-content:center !important; row-gap:4px; }
  .dashboard-header .nav-item { flex:0 0 33.333% !important; max-width:33.333% !important; text-align:center; }
  .dashboard-header .nav-link { padding:8px 2px !important; font-size:12.5px !important; white-space:nowrap; }
}
</style>
<div class="dashboard-tab" style="border-radius:10px; overflow:hidden; margin-bottom:0;">
  <ul class="nav nav-tabs nav-justified dashboard-header p-2">
    <% if current_active_profile&.id == marriage_profile.id %>
      <%# The tab for the section being viewed is bold (by section, not by page type) %>
      <% on = ->(controller, action = nil) { controller_name == controller && (action.nil? || action_name == action) ? 'font-weight-bold' : '' } %>
      <li class="nav-item">
        <a class="nav-link text-white <%= on.call('marriage_profiles', 'dashboard') %>" href="<%= current_active_profile.present? ? dashboard_marriage_profile_path(current_active_profile) : root_path %>">
          <i class="fa fa-tachometer"></i>
          <%= t('dashboard.tabs.dashboard') %>
        </a>
      </li>
      <li class="nav-item ">
        <a class="nav-link text-white <%= on.call('marriage_profiles', 'profile_info') %>"
           href="<%= current_active_profile.present? ? profile_info_marriage_profile_path(current_active_profile) : root_path %>">
          <i class="fa fa-user"></i>
          <%= t('dashboard.tabs.profile') %>
        </a>
      </li>
      <li class="nav-item">
        <%= link_to messages_path,
                    class: "nav-link text-white #{on.call('messages')}" do %>
          <i class="fa fa-envelope"></i>
          <%= t('dashboard.tabs.messages') %>
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to current_active_profile&.partner_preference.present? ?
                        partner_preference_path(current_active_profile.partner_preference) : new_partner_preference_path,
                    class: "nav-link text-white #{on.call('partner_preferences')}" do %>
          <i class="fas fa-user-shield"></i>
          <%= t('dashboard.tabs.preference') %>
        <% end %>
      </li>
      <li class="nav-item">
        <%= link_to orders_path,
                    class: "nav-link text-white #{on.call('orders')}" do %>
          <i class="fa fa-cart-arrow-down" aria-hidden="true"></i>
          <%= t('dashboard.tabs.orders') %>
        <% end %>
      </li>
    <% else %>
      <li class="nav-item">
        <span class="nav-link text-white font-weight-bold" style="cursor:default;"><%= t('dashboard.tabs.profile_details') %></span>
      </li>
    <% end %>
  </ul>
