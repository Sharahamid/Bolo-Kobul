<%# Real ads uploaded in Admin > Ads; nothing shows when a slot has no active ad %>
<% ads = [Ad.active.home_page_top.first, Ad.active.home_page_bottom.first].select { |ad| ad&.image&.attached? } %>
<% if ads.any? %>
  <div class="flex-sm-fill ads-right-sidebar">
    <div class="d-sm-flex flex-sm-column align-items-center">
      <% ads.each_with_index do |ad, i| %>
        <div class="<%= i.zero? ? 'pb-2' : 'pt-2' %> <%= ad_class(ad) %>">
          <%= link_to ad.url.presence || '#', target: '_blank', rel: 'noopener' do %>
            <%= image_tag ad.image_url, width: '240', class: 'img-responsive', alt: ad.title.to_s %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
