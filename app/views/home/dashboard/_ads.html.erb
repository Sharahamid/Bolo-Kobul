<div class="flex-sm-fill ads-right-sidebar">
  <div class="d-sm-flex flex-sm-column align-items-center">
    <% top_ad = Ad.active.home_page_top.first %>
    <div class="pb-2 <%= ad_class(top_ad, 'ss_BK.jpg') %>">
      <%= link_to top_ad&.url || '#', target: '_blank' do %>
        <%= image_tag Ad.dashboard_top || 'ss_BK.jpg', width:'240', class: 'img-responsive' %>
      <% end %>
    </div>

    <% bottom_ad = Ad.active.home_page_bottom.first %>
    <div class="pt-2 <%= ad_class(bottom_ad, 'ad_BK.webp') %>">
      <%= link_to bottom_ad&.url || '#', target: '_blank' do %>
        <%= image_tag Ad.dashboard_bottom || 'ad_BK.webp', width:'240', class: 'img-responsive' %>
      <% end %>
    </div>
  </div>
</div>
