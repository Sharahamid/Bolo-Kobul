<div class="bk-card-content p-2 border-top">
  <div class="d-flex flex-row text-black">
    <div class="info-label flex-fill">
      <%= years_label(marriage_profile.age) %>
    </div>
    <div class="info-value align-self-end">
      <i class="fas fa-graduation-cap"></i>
      <span title=" <%= marriage_profile.highest_education_level? ? enum_label(:marriage_profile, :highest_education_level, marriage_profile&.highest_education_level) : '' %>"
            data-toggle="tooltip"
            data-placement="top">
            <%= enum_label(:marriage_profile, :highest_education_level, marriage_profile&.highest_education_level) %>
          </span>
    </div>
  </div>
  <div class="d-flex flex-row text-black">
    <div class="info-label flex-fill">
      <%= local_digits(marriage_profile.height_ft) %>
      '<%= local_digits(marriage_profile.height_inch) %>''
    </div>
    <div class="info-value align-self-end">
      <i class="fas fa-user-md"></i>
      <span title="<%= marriage_profile.current_occupation.present? ? occupation_label(marriage_profile&.current_occupation) : '' %>"
            data-toggle="tooltip"
            data-placement="top">
            <%= occupation_label(marriage_profile&.current_occupation) %>
          </span>
    </div>
  </div>
  <div class="">
    <div class="d-flex flex-row text-black">
      <div class="info-label flex-fill">
        <i class="fa fa-map-marker" aria-hidden="true"></i>
        <span title="<%= district_label(marriage_profile&.hometown) %>" data-toggle="tooltip" data-placement="top">
          <%= district_label(marriage_profile&.hometown) %>
        </span>
      </div>
    </div>

  </div>
</div>