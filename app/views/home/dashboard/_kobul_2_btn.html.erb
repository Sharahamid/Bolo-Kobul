<% kobul2_waiting = false %>
<div style="display:flex; gap:8px; padding:0 8px 8px;">
  <% if current_active_profile&.chat_friendships&.where(status: 2)&.map(&:chat_friend_id)&.include?(profile.id) %>
    <%= link_to profile_message_path(profile),
                class: "kobul_btn kobul_2",
                style: "flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;" do %>
      <%= t('kobul.chat_butterfly') %>
    <% end %>
  <% elsif current_active_profile&.chat_friendships&.where(status: 1)&.map(&:chat_friend_id)&.include?(profile.id) %>
    <a href="<%= accept_request_chat_friendship_path(profile) %>" data-method="PATCH" class="kobul_btn kobul_2" <%= tag.attributes(data: kobul_explain_data(:accept2, profile)) %>
       data-butterfly-target="bk-target-chats"
       style="flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;"
       data-toggle="tooltip" title="<%= kobul_tip('accept_kobul_2') %>">
      <%= t('kobul.accept_kobul_2') %>
    </a>
  <% elsif current_active_profile&.chat_friendships&.map(&:chat_friend_id)&.include?(profile.id) %>
    <%# The explanation shows as a line under the buttons, not a pop-up over the profile %>
    <% kobul2_waiting = true %>
    <span class="kobul_btn kobul_2"
       style="flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px; cursor:default;">
      <%= t('kobul.pending') %>
    </span>
  <% else %>
    <a href="<%= send_request_chat_friendship_path(profile) %>"
       <%= tag.attributes(data: kobul_explain_data(:send2, profile)) %>
       class="kobul_btn kobul_2"
       data-method="post"
       data-butterfly-target="bk-target-chats"
       style="flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;"
       data-toggle="tooltip" title="<%= kobul_tip('send_kobul_2') %>">
      <%= t('kobul.kobul_2') %>
    </a>
  <% end %>

  <%# Reject is offered until this member sends a 2nd Kobul (then they cancel it from the pending list) %>
  <% unless current_active_profile&.chat_friendships&.where(status: 0)&.exists?(chat_friend_id: profile.id) %>
  <%= link_to reject_request_chat_friendship_path(profile),
              method: :patch,
              data: { confirm: t('kobul.confirm.reject_1') },
              class: "kobul_cancel-btn",
              style: "flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;" do %>
    <i class="fa fa-close"></i> <%= t('kobul.reject') %>
  <% end %>
  <% end %>
</div>
<% if kobul2_waiting %>
  <p style="margin:0; padding:0 10px 10px; font-size:11px; line-height:1.45; color:#8a7a66; text-align:center;"><%= kobul_tip('kobul_2_pending') %></p>
<% end %>
