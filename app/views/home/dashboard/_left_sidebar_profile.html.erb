<style>
  .left-sidebar-card .kobul_btn { border-color: #FFB627 !important; color: #854F0B !important; }
  .left-sidebar-card .kobul_btn { border-color: #FFB627 !important; color: #854F0B !important; }
  .left-sidebar-card .kobul_btn, .left-sidebar-card a.kobul_btn, .left-sidebar-card button.kobul_btn { color:#854F0B !important; border-color:#FFB627 !important; border-radius:8px !important; }
  .left-sidebar-card .kobul_btn,
  .left-sidebar-card .bk_favourite-btn,
  .left-sidebar-card .kobul_cancel-btn,
  .left-sidebar-card .kobul_2 { border-radius: 8px !important; }
  .left-sidebar-card .bk-own-photo-wrap { position:absolute; bottom:-32px; left:50%; transform:translateX(-50%); width:64px; height:64px; border-radius:50%; border:3px solid #fff; box-shadow:0 2px 8px rgba(0,0,0,0.15); box-sizing:border-box; }
  .left-sidebar-card .bk-own-photo-wrap img { width:100% !important; height:100% !important; object-fit:cover !important; border-radius:50% !important; border:none !important; box-shadow:none !important; }
  .left-sidebar-card .bk-photo-wrap { cursor:pointer; position:absolute; bottom:-43px; left:50%; transform:translateX(-50%); width:86px; height:86px; border-radius:50%; border:4px solid #fff; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.15); box-sizing:border-box; }
  .left-sidebar-card .bk-photo-wrap img { width:100% !important; height:100% !important; object-fit:cover !important; border-radius:50% !important; border:none !important; }
  .left-sidebar-card .bk-photo-wrap:hover .bk-photo-overlay { opacity:1; }
  /* The "Add photo" placeholder is shown whole inside the circle, not cropped */
  .left-sidebar-card .bk-own-photo-wrap img.bk-photo-placeholder, .left-sidebar-card .bk-photo-wrap img.bk-photo-placeholder { object-fit:contain !important; padding:8px; background:#fff; }
  .left-sidebar-card .bk-photo-overlay { position:absolute; inset:0; border-radius:50%; background:rgba(0,0,0,0.35); opacity:0; transition:opacity .2s; display:flex; align-items:center; justify-content:center; }
  .left-sidebar-card .bk-own-photo-wrap .camera-icon-area { position:absolute; bottom:2px; right:2px; z-index:10; }
  .left-sidebar-card .bk-own-photo-wrap .camera-icon-area i { background:rgba(0,0,0,0.55); color:#fff; border-radius:50%; padding:3px; font-size:10px; cursor:pointer; }
  .left-sidebar-card .bk-info-row { display:flex; align-items:center; gap:7px; background:#f8f8f8; border-radius:8px; padding:7px 10px; font-size:12px; color:#333; font-weight:500; margin-bottom:6px; }
  .left-sidebar-card .bk-info-icon { font-size:14px; color:#FFB627; flex-shrink:0; }
  .left-sidebar-card .bk-top-row { display:flex; gap:4px; margin-bottom:6px; }
  .left-sidebar-card .bk-top-pill { flex:1; background:#f8f8f8; border-radius:8px; padding:7px 4px; font-size:11px; color:#333; font-weight:500; text-align:center; display:flex; align-items:center; justify-content:center; gap:4px; }
  .left-sidebar-card .bk-action-row { display:flex; gap:8px; margin-top:2px; }
  .left-sidebar-card .bk-action-row a, .left-sidebar-card .bk-action-row span { flex:1; border-radius:8px !important; text-align:center; font-size:11px; padding:8px 4px; display:flex; align-items:center; justify-content:center; gap:5px; }
  .left-sidebar-card .bk-report-link { display:inline-flex; align-items:center; gap:6px; margin-top:12px; background:none; border:none; color:#999; font-size:12px; cursor:pointer; padding:4px 8px; }
  .left-sidebar-card .bk-report-link:hover { color:#FF596C; }
  #bk-photo-modal { display:none; position:fixed; inset:0; background:rgba(0,0,0,0.88); z-index:9999; align-items:center; justify-content:center; flex-direction:column; gap:12px; }
  #bk-photo-modal img { width:min(300px, 80vw); height:min(300px, 80vw); border-radius:50%; object-fit:cover; border:4px solid #FFB627; }
  #bk-photo-modal p { color:rgba(255,255,255,0.5); font-size:12px; margin:0; }
  .bk-todo { text-align:left; margin:0 0 10px; }
  .bk-todo-title { font-size:11px; font-weight:700; color:#633806; margin:2px 0 6px; }
  .bk-todo-link { display:flex; align-items:center; justify-content:space-between; gap:8px; padding:7px 10px; margin-bottom:5px;
                  background:#FFF8E6; border:0.5px solid #FAC775; border-radius:8px; font-size:11px; font-weight:600;
                  color:#854F0B !important; text-decoration:none !important; line-height:1.3; transition:background .15s; }
  .bk-todo-link:hover { background:#FFEFC2; }
  .bk-todo-link i { font-size:9px; color:#FFB627; flex-shrink:0; }
</style>

<div class="left-sidebar-card" style="border-radius:12px; overflow:hidden; box-shadow:0 2px 8px rgba(0,0,0,0.07); border:0.5px solid #eee; background:#fff;">

  <% if marriage_profile&.id == current_active_profile&.id %>
    <div style="background:linear-gradient(135deg,#FFB627,#ffca5e); height:70px; position:relative; display:flex; justify-content:center;">
      <div class="bk-own-photo-wrap">
        <%= render 'home/dashboard/profile_photo', marriage_profile: marriage_profile %>
      </div>
    </div>

    <div style="padding:36px 14px 12px; text-align:center;">
      <div style="display:flex; align-items:center; justify-content:center; gap:5px; margin-bottom:8px; flex-wrap:wrap;">
        <span style="background:#FFF3CC; color:#854F0B; font-size:10px; font-weight:700; padding:2px 8px; border-radius:20px;"><%= marriage_profile&.unique_id %></span>
        <strong style="font-size:13px; color:#222;"><%= marriage_profile&.name&.split&.first %></strong>
        <% if marriage_profile&.verified %>
          <i title="<%= t('profile_card.verified') %>" class="fas fa-check-circle" style="color:#FFB627; font-size:13px;"></i>
        <% end %>
      </div>

      <% pct = current_active_profile.profile_completeness.to_i %>
      <div style="display:flex; justify-content:space-between; font-size:10px; color:#888; margin-bottom:3px;">
        <span><%= profile_t('dashboard.profile_complete', current_active_profile) %></span>
        <span style="color:#FFB627; font-weight:700;"><%= local_digits(pct) %>%</span>
      </div>
      <div style="height:5px; background:#f0f0f0; border-radius:4px; overflow:hidden; margin-bottom:8px;">
        <div style="width:<%= pct %>%; height:100%; background:linear-gradient(90deg,#FFB627,#ffca5e); border-radius:4px;"></div>
      </div>
      <% todo = current_active_profile.sections_to_update %>
      <% if todo.any? %>
        <div class="bk-todo">
          <div class="bk-todo-title"><%= profile_t('dashboard.todo_title', current_active_profile) %></div>
          <% todo.each do |section| %>
            <%= link_to profile_info_marriage_profile_path(current_active_profile, anchor: "update-#{section.to_s.dasherize}"), class: 'bk-todo-link' do %>
              <span><%= profile_t("dashboard.todo.#{section}", current_active_profile) %></span>
              <i class="fas fa-chevron-right"></i>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%= render 'home/dashboard/create_and_edit_btns' %>

      <div style="border-top:0.5px solid #f0f0f0; padding-top:8px; margin-top:8px; display:flex; justify-content:space-around;">
        <a id="bk-target-requests-sent" href="<%= pending_profiles_marriage_profiles_path %>" style="flex:1; text-align:center; text-decoration:none;">
          <div style="font-size:16px; font-weight:700; color:#FFB627; line-height:1;"><%= get_pending_profiles.present? ? get_pending_profiles.count : 0 %></div>
          <div style="font-size:9px; color:#999; margin-top:2px; line-height:1.3;"><%= get_pending_profiles.count == 1 ? t('dashboard.request') : t('dashboard.requests') %><br><%= t('dashboard.sent') %></div>
        </a>
        <a id="bk-target-chat-requests" href="<%= pending_chat_profiles_chat_friendships_path %>" style="flex:1; text-align:center; text-decoration:none;">
          <div style="font-size:16px; font-weight:700; color:#FFB627; line-height:1;"><%= get_pending_chat_profiles.present? ? get_pending_chat_profiles.count : 0 %></div>
          <div style="font-size:9px; color:#999; margin-top:2px; line-height:1.3;"><%= get_pending_chat_profiles.to_a.count == 1 ? t('dashboard.chat_request') : t('dashboard.chat_requests') %><br><%= t('dashboard.sent') %></div>
        </a>
        <a href="<%= favourites_path %>" style="flex:1; text-align:center; text-decoration:none;">
          <% fav_count = current_active_profile.favourites.joins("INNER JOIN marriage_profiles ON marriage_profiles.id = favourites.favourite_profile_id").count %>
          <div style="font-size:16px; font-weight:700; color:#FFB627; line-height:1;"><%= fav_count %></div>
          <div style="font-size:9px; color:#999; margin-top:2px; line-height:1.3;"><%= t('dashboard.favourite') %><br><%= fav_count == 1 ? t('dashboard.profile_word') : t('dashboard.profiles_word') %></div>
        </a>
      </div>
      <div style="border-top:0.5px solid #eee; margin:10px 0 0;"></div>
      <div style="background:#FF596C; border-radius:10px; padding:12px 14px; margin-top:10px;">
        <div style="font-size:12px; font-weight:700; color:#fff; text-align:center; margin-bottom:8px;">🦋 <%= t('dashboard.butterflies') %></div>
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#fff; margin-bottom:4px;"><span><%= t('dashboard.balance') %></span><span><%= local_digits(current_user.butterfly_number.to_i) %></span></div>
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#fff; margin-bottom:10px;"><span><%= t('dashboard.in_process') %></span><span><%= local_digits(current_user.block_butterfly_number.to_i) %></span></div>
        <%= link_to t('dashboard.get_more'), new_order_path, class: 'btn btn-sm btn-default white-background bk-purchase', style: 'width:100%; font-size:11px;' %>
      </div>
    </div>

  <% else %>
    <div style="background:linear-gradient(135deg,#FFB627,#ffca5e); height:90px; position:relative; text-align:center;">
      <div class="bk-photo-wrap" onclick="bkOpenPhoto('<%= marriage_profile.profile_image.large_profile_thumb.url rescue '' %>')">
        <%= render 'home/dashboard/profile_photo', marriage_profile: marriage_profile %>
        <div class="bk-photo-overlay">
          <i class="fas fa-search-plus" style="color:#fff; font-size:18px;"></i>
        </div>
      </div>
    </div>

    <div style="padding:50px 14px 16px; text-align:center;">
      <div style="display:flex; align-items:center; justify-content:center; gap:6px; flex-wrap:wrap; margin-bottom:12px;">
        <span style="background:#FFF3CC; color:#854F0B; font-size:11px; font-weight:700; padding:3px 12px; border-radius:20px;"><%= marriage_profile&.unique_id %></span>
        <% if marriage_profile&.matching_percentage.to_i > 0 %>
          <span class="bk-match-badge" style="background:#e8f5e9; color:#2e7d32; font-size:11px; font-weight:700; padding:3px 12px; border-radius:20px; white-space:nowrap;">⭐ <%= t('profile_card.match', percent: local_digits(marriage_profile.matching_percentage)) %></span>
        <% end %>
      </div>

      <div style="height:0.5px; background:#eee; margin:0 0 10px;"></div>

      <div class="bk-top-row">
        <div class="bk-top-pill"><%= years_label(marriage_profile.age) %></div>
        <div class="bk-top-pill"><%= local_digits(marriage_profile.height_ft) %>'<%= local_digits(marriage_profile.height_inch) %>"</div>
        <div class="bk-top-pill">
          <i class="fas fa-map-marker-alt bk-info-icon"></i>
          <span style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;"><%= district_label(marriage_profile&.hometown) %></span>
        </div>
      </div>

      <div class="bk-info-row">
        <i class="fas fa-graduation-cap bk-info-icon"></i>
        <span><%= enum_label(:marriage_profile, :highest_education_level, marriage_profile&.highest_education_level) %></span>
      </div>

      <% if marriage_profile&.current_occupation.present? %>
        <div class="bk-info-row">
          <i class="fas fa-briefcase bk-info-icon"></i>
          <span><%= occupation_label(marriage_profile&.current_occupation) %></span>
        </div>
      <% end %>

      <div class="request-card-bottom border-top pt-2">
        <% if current_active_profile.chat_friendships.where(status: 2).map(&:chat_friend_id).include?(marriage_profile.id) %>
          <div class="bk-action-row">
            <%= link_to profile_message_path(marriage_profile), class: 'kobul_btn kobul_2',
                        style: 'background:#FFB627; border-color:#FFB627; color:#412402; font-weight:600;' do %>
              <i class="fas fa-comment"></i> <%= t('kobul.chat') %>
            <% end %>
          </div>
        <% elsif current_active_profile.chat_friendships.where(status: 0).map(&:chat_friend_id).include?(marriage_profile.id) %>
          <div class="bk-action-row">
            <a href="<%= reject_request_chat_friendship_path(marriage_profile) %>" data-method="patch" class="kobul_btn kobul_2" style="font-size:11px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;" data-toggle="tooltip" title="<%= t('kobul.tip.cancel_kobul_2') %>" data-confirm="<%= t('kobul.confirm.cancel_kobul_2') %>"><%= t('kobul.kobul_2_pending') %></a>
            <% if current_active_profile.favourite_profile_ids.include?(marriage_profile.id) %>
              <%= link_to remove_favourites_path(favourite_profile_id: marriage_profile.id), method: :delete, class: 'kobul_cancel-btn' do %>
                <i class="fa fa-close"></i> <%= t('kobul.remove') %>
              <% end %>
            <% else %>
              <%= link_to favourites_path(favourite_profile_id: marriage_profile.id), method: :post, class: 'bk_favourite-btn' do %>
                <i class="far fa-heart"></i> <%= t('kobul.favourite') %>
              <% end %>
            <% end %>
          </div>
        <% elsif current_active_profile.favourite_profiles.include?(marriage_profile) %>
          <%= render 'home/dashboard/send_butterfly_and_remove_favourite_btns', profile: marriage_profile %>
        <% elsif get_requested_profiles.include?(marriage_profile) %>
          <%= render 'home/dashboard/accept_and_cancel_btns', profile: marriage_profile %>
        <% elsif current_active_profile.pending_friends.include?(marriage_profile) %>
          <div class="bk-action-row">
            <a href="<%= cancel_request_marriage_profile_path(marriage_profile) %>" data-method="patch" class="kobul_btn" style="flex:1; font-size:11px; padding:8px 4px; border-radius:8px !important; display:flex; align-items:center; justify-content:center; gap:4px;" data-toggle="tooltip" title="<%= t('kobul.tip.cancel_kobul_1') %>" data-confirm="<%= t('kobul.confirm.cancel_kobul_1') %>"><%= t('kobul.pending') %></a>
            <% if current_active_profile.favourite_profile_ids.include?(marriage_profile.id) %>
              <%= link_to remove_favourites_path(favourite_profile_id: marriage_profile.id), method: :delete, class: 'kobul_cancel-btn' do %>
                <i class="fa fa-close"></i> <%= t('kobul.remove') %>
              <% end %>
            <% else %>
              <%= link_to favourites_path(favourite_profile_id: marriage_profile.id), method: :post, class: 'bk_favourite-btn' do %>
                <i class="far fa-heart"></i> <%= t('kobul.favourite') %>
              <% end %>
            <% end %>
          </div>
        <% elsif Friendship.where('(friendable_id = ? AND friend_id = ?) OR (friendable_id = ? AND friend_id = ?)', current_active_profile.id, marriage_profile.id, marriage_profile.id, current_active_profile.id).where(status: 1).exists? %>
          <%= render 'home/dashboard/kobul_2_btn', profile: marriage_profile %>
        <% else %>
          <%= render 'home/dashboard/send_and_favourite_btns', marriage_profile: marriage_profile %>
        <% end %>
      </div>
      <% unless marriage_profile.user_id == current_user.id %>
        <button type="button" class="bk-report-link"
                onclick="bkOpenReport('<%= marriage_profile.id %>', '<%= j marriage_profile.unique_id %>', '<%= block_profile_marriage_profile_path(marriage_profile) %>')">
          <i class="fas fa-flag"></i> <%= t('report.menu') %>
        </button>
      <% end %>
      <div style="border-top:0.5px solid #eee; margin:10px 0 0;"></div>
      <div style="background:#FF596C; border-radius:10px; padding:12px 14px; margin-top:10px;">
        <div style="font-size:12px; font-weight:700; color:#fff; text-align:center; margin-bottom:8px;">🦋 <%= t('dashboard.butterflies') %></div>
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#fff; margin-bottom:4px;"><span><%= t('dashboard.balance') %></span><span><%= local_digits(current_user.butterfly_number.to_i) %></span></div>
        <div style="display:flex; justify-content:space-between; font-size:12px; color:#fff; margin-bottom:10px;"><span><%= t('dashboard.in_process') %></span><span><%= local_digits(current_user.block_butterfly_number.to_i) %></span></div>
        <%= link_to t('dashboard.get_more'), new_order_path, class: 'btn btn-sm btn-default white-background bk-purchase', style: 'width:100%; font-size:11px;' %>
      </div>
    </div>
  <% end %>
</div>

<div id="bk-photo-modal" onclick="bkClosePhoto()">
  <span class="bk-wm" style="border-radius:50%;"><img id="bk-photo-modal-img" src="" alt=""></span>
  <p><%= t('dashboard.tap_to_close') %></p>
</div>
<script>
  // Full-size photo on a profile page. While it is open the page behind does not scroll, and
  // the phone's Back button closes the photo instead of leaving the profile.
  function bkOpenPhoto(src) {
    if (!src) return;
    document.getElementById('bk-photo-modal-img').src = src;
    document.getElementById('bk-photo-modal').style.display = 'flex';
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
    if (!(history.state && history.state.bkPhoto)) history.pushState({ bkPhoto: true }, '');
  }
  function bkHidePhoto() {
    document.getElementById('bk-photo-modal').style.display = 'none';
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  }
  function bkClosePhoto() {
    if (history.state && history.state.bkPhoto) { history.back(); } else { bkHidePhoto(); }
  }
  window.addEventListener('popstate', bkHidePhoto);
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && document.getElementById('bk-photo-modal').style.display === 'flex') bkClosePhoto(); });
</script>
