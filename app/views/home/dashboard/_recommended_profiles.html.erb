<style>
  .bk-kobul-unlock { margin:10px 12px 4px; padding:10px 12px; background:#FFF8E6; border:0.5px solid #FAC775; border-radius:10px; display:flex; flex-wrap:wrap; align-items:center; gap:8px 12px; }
  .bk-kobul-unlock-text { flex:1 1 160px; min-width:0; font-size:12px; color:#633806; line-height:1.4; }
  .bk-kobul-unlock-text strong { display:block; font-size:12px; }
  .bk-kobul-unlock-text span { color:#854F0B; }
  .bk-kobul-unlock-bar { flex:1 1 100%; order:3; height:5px; background:#f3e3bd; border-radius:4px; overflow:hidden; }
  .bk-kobul-unlock-bar div { height:100%; background:linear-gradient(90deg,#FFB627,#ffca5e); border-radius:4px; }
  .bk-kobul-unlock-btn { flex:0 0 auto; background:#FFB627; color:#412402 !important; font-size:11px; font-weight:700; padding:6px 12px; border-radius:8px; text-decoration:none !important; white-space:nowrap; }
</style>
<div id="bk-recommendations" class="request-card flex-sm-fill" style="scroll-margin-top:90px; border-radius:10px; overflow:hidden; border:0.5px solid #eee;">
  <div style="background:linear-gradient(135deg,#FFB627,#ffca5e); padding:10px 14px; display:flex; align-items:center; justify-content:space-between;">
    <span style="font-size:13px; font-weight:700; color:#633806;"><%= t('dashboard.recommendations') %></span>
    <% if get_recommended_profiles.present? %>
      <span style="background:#633806; color:#FAC775; font-size:10px; padding:1px 8px; border-radius:20px;"><%= get_recommended_profiles.count %></span>
    <% end %>
  </div>
  <div class="recommended_profiles mb-2">
    <% unless current_active_profile.ready_for_kobul? %>
      <% pct = current_active_profile.profile_completeness.to_i %>
      <div class="bk-kobul-unlock">
        <div class="bk-kobul-unlock-text">
          <strong><%= profile_t('dashboard.unlock_title', current_active_profile, percent: local_digits(pct)) %></strong>
          <span><%= t('dashboard.unlock_text', min: local_digits(MarriageProfile::KOBUL_MIN_COMPLETENESS)) %></span>
        </div>
        <div class="bk-kobul-unlock-bar"><div style="width:<%= [pct, 100].min %>%;"></div></div>
        <%= link_to t('dashboard.complete_profile'), profile_info_marriage_profile_path(current_active_profile), class: 'bk-kobul-unlock-btn' %>
      </div>
    <% end %>
    <% if get_recommended_profiles.present? %>
      <% get_recommended_profiles.each do |p| %>
        <div class="bk-rec-card" data-hide-url="<%= hide_profile_marriage_profile_path(p, format: :json) %>" data-unhide-url="<%= unhide_profile_marriage_profile_path(p, format: :json) %>" data-id="<%= p.unique_id %>" style="padding:10px 12px; border-bottom:0.5px solid #f5f5f5; position:relative;">
          <button type="button" class="bk-not-interested" title="<%= t('hidden.button_tip') %>"
                  style="position:absolute; top:8px; right:10px; background:none; border:none; color:#b0a28a; font-size:11px; padding:2px 4px; cursor:pointer; display:inline-flex; align-items:center; gap:4px;">
            <i class="fas fa-eye-slash"></i> <%= t('hidden.button') %>
          </button>
          <div style="display:flex; align-items:center; gap:10px; margin-bottom:8px;">
            <div style="flex-shrink:0;">
              <%= render 'shared/profile_photo', profile: p %>
            </div>
            <div style="flex:1; min-width:0;">
              <div style="display:flex; align-items:center; gap:4px; margin-bottom:4px;">
                <%= link_to p&.unique_id, profile_info_marriage_profile_path(p), style: "font-weight:700; color:#854F0B; font-size:13px; text-decoration:none;" %>
                <% if p.verified %><i class="fas fa-check-circle" style="color:#FFB627; font-size:11px;"></i><% end %>
                <% if p.matching_percentage.present? %>
                  <%= render 'shared/match_badge', profile: p, percent: p.matching_percentage %>
                <% end %>
              </div>
              <div style="display:flex; flex-wrap:wrap; gap:3px; margin-bottom:3px; align-items:center;">
                <span style="background:#FFF3CC; color:#854F0B; font-size:10px; padding:1px 6px; border-radius:5px;"><%= years_label(p.age) %></span>
                <span style="background:#FFF3CC; color:#854F0B; font-size:10px; padding:1px 6px; border-radius:5px;"><%= local_digits(p.height_ft) %>'<%= local_digits(p.height_inch) %>''</span>
                <span style="background:#FFF3CC; color:#854F0B; font-size:10px; padding:1px 6px; border-radius:5px;"><i class="fas fa-map-marker-alt" style="color:#854F0B; font-size:9px; margin-right:2px;"></i><%= district_label(p&.hometown) %></span>
              </div>
              <div style="font-size:10px; color:#999; display:flex; align-items:center; flex-wrap:wrap; gap:3px;">
                <span style="display:inline-flex; align-items:center; gap:2px;"><i class="fas fa-graduation-cap" style="color:#FFB627; font-size:10px;"></i><%= p.highest_education_level? ? enum_label(:marriage_profile, :highest_education_level, p&.highest_education_level) : '' %></span><% if p.current_occupation.present? %><span>&middot;</span><span style="display:inline-flex; align-items:center; gap:2px;"><i class="fas fa-briefcase" style="color:#FFB627; font-size:10px;"></i><%= occupation_label(p.current_occupation) %></span><% end %>
              </div>
            </div>
          </div>
          <%= render 'home/dashboard/send_and_favourite_btns', marriage_profile: p %>
        </div>
      <% end %>
    <% else %>
      <%= render 'shared/bk_empty_state', compact: true, icon: 'fa-heart', title: t('bkx.empty.matches_title'), text: t('bkx.empty.matches_text'),
                 actions: [[t('bkx.empty.search'), search_page_marriage_profile_path(current_active_profile)]] %>
    <% end %>
  </div>
</div>
<script>
  // Computers: when the page has empty space below, the scrolling Recommendations list
  // grows into it, leaving a little white space at the bottom of the white box
  (function () {
    function fit() {
      var list = document.querySelector('#bk-recommendations .recommended_profiles');
      var box = list && list.closest('.dashboard-tab');
      if (!list || !box) return;
      list.style.maxHeight = '';
      if (window.innerWidth < 576 || list.scrollHeight <= list.clientHeight + 2) return;
      var lastBottom = 0;
      Array.prototype.forEach.call(box.querySelectorAll('*'), function (el) {
        if (el.offsetParent !== null && !list.contains(el)) {
          var b = el.getBoundingClientRect().bottom;
          if (b > lastBottom) lastBottom = b;
        }
      });
      lastBottom = Math.max(lastBottom, list.getBoundingClientRect().bottom);
      var space = box.getBoundingClientRect().bottom - lastBottom - 8;
      if (space > 0) list.style.maxHeight = Math.min(list.clientHeight + space, list.scrollHeight) + 'px';
    }
    window.addEventListener('load', fit);
    window.addEventListener('resize', function () { clearTimeout(window.bkRecFit); window.bkRecFit = setTimeout(fit, 150); });
    setTimeout(fit, 300);
  })();
</script>

<script>
  // "Not interested": hides the profile for good (recommendations, search, advanced search)
  (function () {
    if (window.bkNotInterested) return;
    window.bkNotInterested = true;
    var T = <%= raw({ hidden: t('hidden.card_done'), undo: t('hidden.undo'), failed: t('hidden.failed') }.to_json) %>;
    function call(url) {
      var token = document.querySelector('meta[name="csrf-token"]');
      return fetch(url, { method: 'PATCH', credentials: 'same-origin',
        headers: { 'Accept': 'application/json', 'X-CSRF-Token': token ? token.content : '' } });
    }
    document.addEventListener('click', function (e) {
      var btn = e.target.closest('.bk-not-interested');
      if (!btn) return;
      var card = btn.closest('.bk-rec-card');
      btn.disabled = true;
      call(card.dataset.hideUrl).then(function (r) {
        if (!r.ok) throw new Error();
        var saved = card.innerHTML;
        card.innerHTML = '<div style="display:flex; align-items:center; justify-content:space-between; gap:10px; font-size:12px; color:#7a6a50; padding:6px 0;">' +
          '<span><i class="fas fa-eye-slash" style="margin-right:6px;"></i>' + T.hidden.replace('%{id}', card.dataset.id) + '</span>' +
          '<button type="button" class="bk-undo-hide" style="background:none; border:none; color:#854F0B; font-weight:700; text-decoration:underline; cursor:pointer; font-size:12px;">' + T.undo + '</button></div>';
        card.querySelector('.bk-undo-hide').addEventListener('click', function () {
          call(card.dataset.unhideUrl).then(function () { card.innerHTML = saved; });
        });
      }).catch(function () { btn.disabled = false; alert(T.failed); });
    });
  })();
</script>
