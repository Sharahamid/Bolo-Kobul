<div class="request-card flex-sm-fill" style="border-radius:10px; overflow:hidden; border:0.5px solid #eee;">
  <div style="background:linear-gradient(135deg,#FFB627,#ffca5e); padding:10px 14px; display:flex; align-items:center; justify-content:space-between;">
    <span style="font-size:13px; font-weight:700; color:#633806;"><%= t('dashboard.second_kobul_received') %></span>
    <% if get_accepted_profiles.present? %>
      <span style="background:#633806; color:#FAC775; font-size:10px; padding:1px 8px; border-radius:20px;"><%= get_accepted_profiles.count %></span>
    <% end %>
  </div>
  <div class="recommended_profiles mb-2">
    <% if get_accepted_profiles.present? %>
      <% get_accepted_profiles.each do |accepted_profile| %>
        <div class="flex-fill border-bottom">
          <div class="d-flex flex-column">
            <%= render 'home/dashboard/card_profile_info', profile: accepted_profile, profile_action: true %>
            <div class="request-card-bottom p-2 border-top">
              <%= render 'home/dashboard/kobul_2_btn', profile: accepted_profile %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <%= render 'shared/bk_empty_state', compact: true, icon: 'fa-paper-plane', title: t('bkx.empty.requests_title'), text: t('bkx.empty.requests_text'),
                 actions: [[t('bkx.empty.search'), search_page_marriage_profile_path(current_active_profile)],
                           [t('bkx.empty.complete'), profile_info_marriage_profile_path(current_active_profile)]] %>
    <% end %>
  </div>
</div>
