<%# "120+ successful marriages arranged so far" — number set in Admin > Settings > Homepage numbers (0 hides it) %>
<% marriages = SiteStat.marriages_count %>
<% if marriages.positive? %>
<section class="bk-marriages" aria-label="<%= t('bkx.marriages.line') %>">
  <div class="bk-marriages__in">
    <div class="bk-marriages__icon" aria-hidden="true">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#FFB627" stroke-width="2"><circle cx="12" cy="15" r="6"/><path d="M9 4h6l-3 5z" fill="#FFB627"/></svg>
    </div>
    <div class="bk-marriages__num"><%= local_digits(marriages) %>+</div>
    <div class="bk-marriages__txt"><%= t('bkx.marriages.line') %><small><%= t('bkx.marriages.sub') %></small></div>
    <%= link_to t('bkx.marriages.link'), blogs_path(type: 'success_story'), class: 'bk-marriages__link' %>
  </div>
</section>
<% end %>
