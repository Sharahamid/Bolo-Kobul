<div style="background:#FFF8E7; border:1px solid #FFE082; border-radius:6px; padding:16px; margin-bottom:1.5rem;">
  <table width="100%" cellpadding="0" cellspacing="0">
    <% rows.each do |label, value| %>
      <tr>
        <td style="font-size:13px; color:#555555; padding:4px 0; width:170px;" valign="top"><%= label %></td>
        <td style="font-size:14px; color:#333333; padding:4px 0; font-weight:bold;">: <%= value %></td>
      </tr>
    <% end %>
  </table>
</div>
