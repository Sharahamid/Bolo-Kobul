<%# Shared look of the business emails (same style as the member emails) %>
<!DOCTYPE html>
<html>
<body style="margin:0; padding:0; background:#f4f4f4; font-family: Arial, sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0">
<tr><td align="center" style="padding: 2rem 1rem;">
<table width="600" cellpadding="0" cellspacing="0" style="max-width:600px; width:100%;">
  <tr><td style="background:#ffffff; border-radius:8px 8px 0 0; text-align:center; padding: 2rem 2rem 1rem;">
    <img src="https://bolokobul.com/email/bk_logo.png" width="80" style="margin-bottom:10px;" alt="Bolo Kobul" />
    <div style="font-size:11px; color:#888; letter-spacing:2px; text-transform:uppercase;">Wedding Shopping List</div>
    <div style="width:40px; height:2px; background:#FFB627; margin:12px auto 0;"></div>
  </td></tr>
  <tr><td style="background:#412402; padding: 2rem; text-align:center;">
    <div style="font-size:30px;"><%= icon %></div>
    <div style="font-size:22px; font-weight:bold; color:#FFB627; line-height:1.3; margin-top:8px;"><%= title %></div>
    <div style="font-size:14px; color:#FAC775; margin-top:8px;">Dear <%= listing.contact_name.presence || listing.name %>,</div>
  </td></tr>
  <tr><td style="background:#ffffff; padding: 2rem;">
    <%= yield %>
    <p style="font-size:14px; color:#555555; line-height:1.8; margin:1.5rem 0 0;">
      Questions? Email <a href="mailto:support@bolokobul.com" style="color:#FFB627;">support@bolokobul.com</a>
      or WhatsApp <a href="https://wa.me/8801611820410" style="color:#FFB627;">+8801611820410</a>.
    </p>
  </td></tr>
  <tr><td style="background:#FFF8E7; padding:1.5rem 2rem; text-align:center; border-top:1px solid #FFE082; border-radius:0 0 8px 8px;">
    <div style="font-size:14px; color:#888888;">Warm wishes,</div>
    <div style="font-size:15px; font-weight:bold; color:#FFB627; margin-top:4px;">Team Bolo Kobul</div>
    <div style="font-size:11px; color:#aaaaaa; margin-top:12px;">
      <a href="https://bolokobul.com" style="color:#FFB627; text-decoration:none;">bolokobul.com</a>
    </div>
  </td></tr>
</table>
</td></tr>
</table>
</body>
</html>
