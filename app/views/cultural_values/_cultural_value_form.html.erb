<%= form_for cultural_value, remote: true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: t('section_form.cultural_value') %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">

      <div class="form-group">

        <%= f.text_field :nationality,
                         placeholder: t('section_form.nationality'),
                         class: 'form-control sign_up-input-field',
                         title: t('section_form.nationality'),
                         data: {toggle: 'tooltip', placement: 'top'} %>
        <small class="text-danger"> <%= f.object.errors[:nationality].present? ? f.object.errors.full_messages_for(:nationality).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.select :birth_place, District.order(:name).pluck(:name, :id).map { |name, id| [I18n.locale == :bn ? district_label(name) : name, id] },
                     {prompt: t('section_form.birth_place')},
                     class: 'form-control sign_up-input-field',
                     data: {toggle: "tooltip", placement: "top" },
                     title:t('section_form.birth_place') %>
        <small class="text-danger"> <%= f.object.errors[:birth_place].present? ? f.object.errors.full_messages_for(:birth_place).first : '' %> </small>
      </div>
      <div id="birth_place_abroad_fields" class="mb-3" style="display:none;">
        <div class="row mt-2">
          <div class="col-6">
	    <%= f.select :birth_place_country, options_for_select(Country.order(:name).pluck(:name), f.object.birth_place_country), {prompt: t('section_form.country_req')}, class: 'form-control sign_up-input-field', id: 'birth_place_country_input' %>
          </div>
          <div class="col-6">
            <%= f.text_field :birth_place_city, placeholder: t('section_form.city_req'), class: 'form-control sign_up-input-field', id: 'birth_place_city_input' %>
          </div>
        </div>
      </div>


      <div class="form-group">
        <%= f.select :mother_tongue, choice_options(:languages),
                     {prompt: t('section_form.mother_tongue')},
                     class: 'form-control sign_up-input-field',
                     title: t('section_form.mother_tongue'),
                     data: {toggle: 'tooltip', placement:'top'}
        %>
        <small class="text-danger"> <%= f.object.errors[:mother_tongue].present? ? f.object.errors.full_messages_for(:mother_tongue).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.label :languages_spoken, t('section_form.languages_spoken') %><br/>
        <div class="d-sm-flex flex-sm-row flex-wrap">
          <% User::LANGUAGES.each do |value, id| %>
            <label class="check-box-lbl-item">
              <%= check_box_tag "cultural_value[languages_spoken][]",
                                id,
                                checked_languages_spoken(id) %>
              <span class="ck-box-lbl" title="<%= choice_label(:languages, value) %>" data-toggle='tooltip' data-placement="top">
              <%= choice_label(:languages, value) %>
              </span>
            </label>
          <% end %>
        </div>

      </div>

      <div class="form-group">
        <%= f.label :religion %>
        <% profile = current_active_profile %>
        <% religion_display = profile&.mr_other? ? (profile&.other_religion.present? ? profile.other_religion : 'Other') : profile&.religion&.humanize %>
        <p class="form-control sign_up-input-field" style="background:#f5f5f5; cursor:not-allowed;">
          <%= religion_display || 'Not specified' %>
        </p>
        <%= f.hidden_field :religion, value: cultural_value.religion %>
      </div>

      <div class="form-group">
        <%= f.select :born_or_reverted, choice_options(:born_or_reverted),
                     {prompt: t('section_form.born_or_reverted')},
                     class: 'form-control sign_up-input-field',
                     title: t('section_form.born_or_reverted'),
                     data: {toggle: 'tooltip', placement:'top'}
        %>
        <small class="text-danger"> <%= f.object.errors[:born_or_reverted].present? ? f.object.errors.full_messages_for(:born_or_reverted).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.select :attend_religious_event, choice_options(:boolean_data),
                     {prompt: t('section_form.attend_religious_events')},
                     class: 'form-control sign_up-input-field',
                     title: t('section_form.attend_religious_events_lc'),
                     data: {toggle: 'tooltip', placement:'top'}
        %>
        <small class="text-danger"> <%= f.object.errors[:attend_religious_event].present? ? f.object.errors.full_messages_for(:attend_religious_event).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.text_area :political_view,
                        placeholder: t('section_form.political_view'),
                     class: 'form-control sign_up-input-field',
                     title: t('section_form.political_view'),
                     data: {toggle: 'tooltip', placement:'top'}
        %>
        <small class="text-danger"> <%= f.object.errors[:political_view].present? ? f.object.errors.full_messages_for(:political_view).first : '' %> </small>
      </div>



    </div>
  </div>
  <script>
  (function() {
    var sel = document.querySelector('select[name="cultural_value[birth_place]"]');
    var field = document.getElementById('birth_place_abroad_fields');
    var input = document.getElementById('birth_place_country_input');
    if (!sel || !field) return;
    function toggle() {
      if (sel.value === '65') {
        field.style.display = 'block';
        input.required = true;
      } else {
        field.style.display = 'none';
        input.required = false;
      }
    }
    sel.addEventListener('change', toggle);
    toggle();
  })();
  </script>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>
