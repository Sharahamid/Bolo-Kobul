<%# Server error page that cannot fail itself: no site layout, no database, no member data.
    Logging out (or going back) gets the member out of a page that keeps failing. %>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Something went wrong | Bolo Kobul</title>
  <style>
    body { margin:0; min-height:100vh; display:flex; align-items:center; justify-content:center; background:#f7f5f0;
           font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Bengali", sans-serif; color:#412402; padding:16px; box-sizing:border-box; }
    .card { max-width:420px; width:100%; background:#fff; border:0.5px solid #FAC775; border-radius:14px; padding:28px 22px; text-align:center;
            box-shadow:0 4px 18px rgba(0,0,0,0.06); }
    .mark { width:52px; height:52px; border-radius:50%; background:#FFF3CC; color:#B97A00; font-size:26px; line-height:52px; margin:0 auto 12px; }
    h1 { font-size:19px; margin:0 0 6px; }
    p { font-size:14px; line-height:1.55; color:#633806; margin:0 0 6px; }
    .bn { font-size:14px; color:#854F0B; margin-bottom:18px; }
    .actions { display:flex; flex-direction:column; gap:10px; margin-top:14px; }
    .btn { display:block; width:100%; box-sizing:border-box; padding:11px 14px; border-radius:9px; font-size:14px; font-weight:600;
           text-decoration:none; cursor:pointer; border:1px solid #FAC775; background:#FFF8E6; color:#854F0B; font-family:inherit; }
    .btn.primary { background:#FFB627; border-color:#FFB627; color:#412402; }
    form { margin:0; }
    .help { font-size:12px; color:#9a8a70; margin-top:16px; }
    .help a { color:#B97A00; }
  </style>
</head>
<body>
  <div class="card">
    <div class="mark">!</div>
    <h1>Sorry, something went wrong</h1>
    <p>This page could not be shown just now. Our team has been notified.</p>
    <p class="bn">দুঃখিত, পেজটি এই মুহূর্তে দেখানো যাচ্ছে না। আমাদের টিমকে জানানো হয়েছে।</p>
    <div class="actions">
      <a class="btn primary" href="javascript:history.back()">← Go back · ফিরে যান</a>
      <% if @signed_in %>
        <form action="/users/sign_out" method="post">
          <input type="hidden" name="_method" value="delete">
          <input type="hidden" name="authenticity_token" value="<%= @logout_token %>">
          <button class="btn" type="submit">Log out · লগআউট</button>
        </form>
      <% end %>
    </div>
    <div class="help">Still not working? Write to <a href="mailto:support@bolokobul.com?subject=Page%20error">support@bolokobul.com</a></div>
  </div>
</body>
</html>
