<% if user_signed_in? && current_user.deletion_scheduled? %>
  <div style="background:#FFF5F5; border-bottom:0.5px solid #F09595; padding:10px 16px;">
    <div class="container" style="display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap;">
      <span style="font-size:13px; color:#A32D2D; line-height:1.5;">
        <i class="fas fa-exclamation-triangle"></i>
        <%= t('deletion_banner.text_html', date: content_tag(:strong, local_date(current_user.deletion_date))) %>
      </span>
      <%= link_to t('settings.cancel_deletion'), cancel_deletion_user_path(current_user), method: :patch,
                  style: 'background:#FFB627; color:#412402; border-radius:8px; padding:6px 14px; font-size:12px; font-weight:600; text-decoration:none; white-space:nowrap;' %>
    </div>
  </div>
<% end %>
