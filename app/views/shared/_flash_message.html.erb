<%# Message bar ("Saved", "Kobul sent"…). It sits in the page, under the header, and pushes
    the page down instead of covering it; it slides away by itself after a few seconds. %>
<% flash.each do |type, msg| %>
  <% next if type.to_s.start_with?("bk_") # internal markers, not messages %>
  <% kind = %w[error danger alert].include?(type.to_s) ? 'error' : 'ok' %>
  <div class="bk-flash-bar bk-flash-bar--<%= kind %>" role="status">
    <div class="bk-flash-bar__in">
      <i class="fas <%= kind == 'error' ? 'fa-exclamation-circle' : 'fa-check-circle' %>" aria-hidden="true"></i>
      <span class="bk-flash-bar__text"><%= flash_text(msg) %></span>
      <button type="button" class="bk-flash-bar__close" aria-label="Close">&times;</button>
    </div>
  </div>
  <% flash.discard %>
<% end %>
<script>
  (function () {
    document.querySelectorAll('.bk-flash-bar:not([data-ready])').forEach(function (bar) {
      bar.setAttribute('data-ready', '1');
      function hide() {
        if (bar.classList.contains('is-hiding')) return;
        bar.style.maxHeight = bar.scrollHeight + 'px';
        bar.offsetHeight; // start the slide from the current height
        bar.classList.add('is-hiding');
        setTimeout(function () { bar.remove(); }, 400);
      }
      bar.querySelector('.bk-flash-bar__close').addEventListener('click', hide);
      setTimeout(hide, <%= 6000 %>);
    });
  })();
</script>
