<%# Match % pill, with a BK+ badge for members who have BK+.
    locals: profile, percent (optional, already worked out) %>
<% percent = local_assigns[:percent] || match_percent(profile) %>
<% plus = profile&.user&.bk_plus? %>
<% if percent.to_i > 0 || plus %>
  <span class="bk-mini-badges">
    <% if plus %><span class="bkp-badge" title="<%= t('bkx.plus.badge_tip') %>">BK+</span><% end %>
    <% if percent.to_i > 0 %><span class="bk-pct-pill"><%= local_digits("%02d" % percent.to_i) %>%</span><% end %>
  </span>
<% end %>
