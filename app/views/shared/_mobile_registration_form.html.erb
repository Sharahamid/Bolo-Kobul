<div class="mobile-registration">
  <div class="mobile-sign-up-form">
    <div class="overlay">
      <div class="container text-center">
        <div class="mobile-reg-form">
          <div class="register text-center">
            <strong><%= t('signup.register_now') %></strong>
            <div class="reg_underline text-center">
              <%= image_tag 'white_reg_line.svg' %>
            </div>
          </div>
          <p class="note"><%= t('signup.private_note') %></p>
          <div class="bk-input-feilds">
            <%= render 'shared/social_login_buttons', placement: 'signup' %>
            <%= form_for @user, url: user_registration_path do |f| %>

              <div class="<%= f.object.errors[:name].present? ? '' : 'form-group' %>">
                <%= f.text_field :name,
                                 autofocus: true,
                                 autocomplete: "full_name",
                                 required: true,
                                 class: 'form-control sign_up-input-field',
                                 placeholder: t('signup.full_name')
                %>
                <small class="text-danger error-text">
                  <%= f.object.errors[:name].present? ? f.object.errors.full_messages_for(:name).first : '' %>
                </small>
              </div>

              <div class="<%= f.object.errors[:email].present? ? '' : 'form-group' %>">
                <%= f.email_field :email,
                                  autofocus: true,
                                  autocomplete: "email",
                                  class: 'form-control sign_up-input-field',
                                  placeholder: t('signup.email') %>
                <small class="text-danger error-text">
                  <%= f.object.errors[:email].present? ? f.object.errors.full_messages_for(:email).first : '' %>
                </small>
              </div>

              <div class="<%= f.object.errors[:phone_number].present? ? '' : 'form-group' %>">
                <%= f.phone_field :phone_number,
                                  autofocus: true,
                                  autocomplete: "phone_number",
                                  required: true, class: 'form-control sign_up-input-field',
                                  placeholder: t('signup.mobile') %>
                <small class="text-danger error-text">
                  <%= f.object.errors[:phone_number].present? ? f.object.errors.full_messages_for(:phone_number).first : '' %>
                </small>
              </div>

              <div class="<%= f.object.errors[:password].present? ? '' : 'form-group' %>">
                <div class="password-field-wrapper">
                  <%= f.password_field :password,
                                       autocomplete: "password",
                                       class: 'form-control sign_up-input-field',
                                       placeholder: t('signup.password'),
                                       minlength: '8',
                                       maxlength: '128',
                                       pattern: "(?=.*[A-Za-z])(?=.*\\d).{8,}",
                                       title: t('signup.password_rule'),
                                       data: {toggle: 'tooltip', placement: 'top'},
                                       id: 'mobile_password',
                                       required: true, 
                                       oninput: "mobileCheckPwd()" %>
                  <button type="button" class="password-eye-btn" onclick="togglePassword('mobile_password', this)">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
                <small class="text-danger error-text">
                  <%= f.object.errors[:password].present? ? f.object.errors.full_messages_for(:password).first : '' %>
                </small>
              </div>

              <div class="<%= f.object.errors[:password_confirmation].present? ? '' : 'form-group' %>">
                <div class="password-field-wrapper">
                  <%= f.password_field :password_confirmation,
                                       autocomplete: "new-password",
                                       class: 'form-control sign_up-input-field',
                                       placeholder: t('signup.confirm_password'),
                                       id: 'mobile_password_confirmation',
                                       required: true, 
                                       oninput: "mobileCheckPwd()" %>
                  <button type="button" class="password-eye-btn" onclick="togglePassword('mobile_password_confirmation', this)">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
                <small class="text-danger error-text" id="mobile_password_match_error">
                  <%= f.object.errors[:password_confirmation].present? ? t('signup.passwords_mismatch') : '' %>
                </small>
              </div>

              <div class="<%= f.object.errors[:created_for].present? ? '' : 'form-group' %>">
                <%= f.select :created_for,
                             options_for_select(User::created_fors.to_h
                                                    .map {
                                                        |k, v| [enum_label(:user, :created_for, k), k]
                                                    }),
                             {prompt: t('signup.created_for')},
                             required: true,
                             class: 'form-control sign_up-input-field' %>
                <small class="text-danger error-text">
                  <%= f.object.errors[:created_for].present? ? f.object.errors.full_messages_for(:created_for).first : '' %>
                </small>
              </div>

              <!--              <div class="notice pb-2">-->
              <!--                <span> (These information will <b>never</b> be disclosed through this platform) </span>-->
              <!--              </div>-->

              <div class="form-group form-check terms_and_condition">
                <label class="form-check-label">
                  <input class="form-check-input" type="checkbox" required> <%= t('signup.terms_html', terms: link_to(t('signup.terms_of_use'), terms_of_uses_path, target: '_blank'), privacy: link_to(t('signup.privacy_policy'), privacy_policies_path, target: '_blank')) %>
                </label>
              </div>
      <%= render 'shared/signup_guard' %>
      <div class="register-btn-section text-center merriweather">
                <button type="submit" class="btn btn-sign_up form-control"><%= t('signup.register_free') %></button>
              </div>
             
	      <script>
	        function mobileCheckPwd() {
                  var pwd = document.getElementById('mobile_password');
                  var conf = document.getElementById('mobile_password_confirmation');
                  var err = document.getElementById('mobile_password_match_error');
                  if (!pwd || !conf || !err) return;
                  if (conf.value.length === 0) {
                    err.textContent = '';
                  } else if (pwd.value.startsWith(conf.value)) {
                    err.textContent = '';
                  } else {
                    err.textContent = <%= raw t('signup.passwords_mismatch').to_json %>;
                  }
                }

                function togglePassword(inputId, button) {
                  var input = document.getElementById(inputId);
                  if (input.type === "password") {
                    input.type = "text";
                    button.textContent = "🙈";
                  } else {
                    input.type = "password";
                    button.textContent = "👁️";
                  }
                }
              </script>                            
            <% end %>
          </div>
        </div>
      </div>
    </div>

  </div>
</div>
