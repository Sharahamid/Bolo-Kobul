<%# Live password checklist under a password box: each rule turns green as it is met.
    Same rules as User#password_regex. Usage: render 'shared/password_checklist', input_id: '...' %>
<% list_id = "bk-pwd-rules-#{input_id}" %>
<ul id="<%= list_id %>" class="bk-pwd-rules" style="list-style:none; margin:6px 0 0; padding:0; display:flex; flex-wrap:wrap; gap:4px 12px; font-size:11.5px; color:#9a8b72; text-align:left;">
  <% [['len', t('pwd_rules.length')], ['upper', t('pwd_rules.upper')], ['lower', t('pwd_rules.lower')], ['digit', t('pwd_rules.digit')], ['symbol', t('pwd_rules.symbol')]].each do |key, label| %>
    <li data-rule="<%= key %>" style="display:inline-flex; align-items:center; gap:4px;"><span class="bk-pwd-dot" style="font-size:10px;">○</span><%= label %></li>
  <% end %>
</ul>
<script>
  (function () {
    var input = document.getElementById('<%= input_id %>');
    var list = document.getElementById('<%= list_id %>');
    if (!input || !list) return;
    var tests = {
      len: function (v) { return v.length >= 8; },
      upper: function (v) { return /[A-Z]/.test(v); },
      lower: function (v) { return /[a-z]/.test(v); },
      digit: function (v) { return /\d/.test(v); },
      symbol: function (v) { return /[^A-Za-z0-9\s]/.test(v); }
    };
    function check() {
      var v = input.value || '';
      list.querySelectorAll('li').forEach(function (li) {
        var ok = tests[li.getAttribute('data-rule')](v);
        li.style.color = ok ? '#1D7A55' : '#9a8b72';
        li.querySelector('.bk-pwd-dot').textContent = ok ? '✓' : '○';
      });
    }
    input.addEventListener('input', check);
    check();
  })();
</script>
