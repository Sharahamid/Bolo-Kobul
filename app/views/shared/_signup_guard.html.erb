<%# Bot checks, invisible to people: a field only bots fill in, and when the form was shown
    (bots send the form within a moment of loading it) %>
<div style="display:none !important; visibility:hidden; position:absolute; left:-9999px;">
  <input type="text" name="user[website]" tabindex="-1" autocomplete="off" placeholder="Leave this empty">
</div>
<input type="hidden" name="user[form_shown]" value="<%= Users::RegistrationsController.form_shown_token %>">
