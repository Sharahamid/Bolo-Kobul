<div id="mySidebar" class="sidebar">
  <div class="site-bar-header pb-4">
    <%= link_to root_path, class: 'site-panel-logo', 'aria-label': 'Bolo Kobul home' do %>
      <%= image_tag 'bk_logo.webp', width: '64', height: '64', alt: 'Bolo Kobul' %>
    <% end %>

    <a href="javascript:void(0)" class="closebtn" onclick="closeNav()">×</a>

    <div class="bk-side-panel-lang"><%= render 'shared/language_switch' %></div>

    <% if current_user.present? %>
      <div class="mobile-site-bar-menu">
        <a href="<%=
          (current_user.marriage_profiles.present? && current_active_profile.present?) ?
              dashboard_marriage_profile_path(current_active_profile) : '#' %>"
           class="bk-active">
          <div class="">
            <i class="fa fa-tachometer"></i>
            <span class="pl-1"><%= t('nav.dashboard') %></span>
          </div>
        </a>
        <a href="<%=
          current_active_profile.present? ?
              profile_info_marriage_profile_path(current_active_profile) : '#' %>"
           class="bk-active">
          <div class="">
            <i class="fa fa-user"></i>
            <span class="pl-1"><%= t('nav.profile') %></span>
          </div>
        </a>
        <a href="<%=
          current_active_profile.present? ?
              orders_path : '#' %>"
           class="bk-active">
          <div class="">
            <i class="fa fa-cart-arrow-down" aria-hidden="true"></i>
            <span class="pl-1"><%= t('nav.orders') %></span>
          </div>
        </a>
        <a href="<%=
          current_active_profile&.partner_preference.present? ?
              partner_preference_path(current_active_profile.partner_preference)
              : new_partner_preference_path %>"
           class="bk-active">
          <div class="">
            <i class="fas fa-user-shield"></i>
            <span class="pl-1"><%= t('nav.preference') %></span>
          </div>
        </a>
        <a href="<%= customer_supports_path  %>" class="bk-active">
          <div class="">
            <i class="fas fa-headset"></i>
            <%= t('nav.reported_issues') %>
          </div>
        </a>
        <a href="<%= privacy_settings_path  %>" class="bk-active">
          <div class="">
            <i class="fa fa-user-cog"></i>
             <%= t('nav.privacy_settings') %>
          </div>
        </a>
        <a href="<%=
          (current_user.present? && current_active_profile.present?) ?
              search_page_marriage_profile_path(current_active_profile) : '#' %>"
           class="bk-active">
          <div class="">
            <i class="far fa-address-card"></i>
            <span class="pl-1"><%= t('nav.search') %></span>
          </div>
        </a>
        <a href="<%= how_it_works_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-cogs"></i>
            <%= t('nav.how_it_works') %>
          </div>
        </a>
        <a href="<%= market_places_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-store"></i>
            <%= t('nav.wedding_shopping') %>
          </div>
        </a>
        <div class="dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <div class="menu-title">
              <i class="fas fa-hands-helping"></i>
              <%= t('nav.assisted_services') %>
            </div>
          </a>
          <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
            <% AssistedService.order(:display_order).each do |assisted_service| %>
              <a class="dropdown-item" href="<%= assisted_service_path(assisted_service) %>">
                <%= assisted_service.name&.titleize %>
              </a>
            <% end %>
          </div>
        </div>
        <a href="<%= precautionary_measures_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-exclamation-circle"></i>
            <%= t('nav.precautionary_measures') %>
          </div>
        </a>
        <a href="<%= notifications_users_path %>" class="bk-active notification-section">
          <div class="">
            <i class="fas fa-hand-holding-heart"></i>
            <%= t('nav.notifications') %>
            <% mob_unread = current_user&.notifications&.unread&.count || 0 %>
            <span class="notification-counter"><%= mob_unread.zero? ? '' : (mob_unread > 99 ? '99+' : mob_unread) %></span>
          </div>
        </a>
        <% unless current_user.self? || current_user.other_as_matchmaker? %>
          <div class="nav-item dropup text-center">
            <a class="nav-link dropdown-toggle" href="#" id="navbarDropdownMenuLink" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
              <%= t('nav.switch_profile') %>
            </a>
            <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
              <% if current_user.marriage_profiles.present? %>
                <% current_user&.marriage_profiles&.each do |profile| %>
                  <a class="dropdown-item" href="<%=
                    profile.persisted? ? switch_marriage_profile_path(profile)
                        : '#' %>">
                    <%= profile&.name || profile&.unique_id %> </a>
                <% end %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

    <% else %>
      <div class="mobile-site-bar-menu">
        <a class="bk-active" href="<%= about_path %>">
          <div class="">
            <i class="fas fa-hand-holding-heart"></i>
            <%= t('nav.about_us') %>
          </div>
        </a>

        <a href="<%= how_it_works_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-cogs"></i>
            <%= t('nav.how_it_works') %>
          </div>
        </a>

        <a href="<%= faqs_path %>" class="bk-active">
          <div class="">
            <i class="far fa-question-circle"></i>
            <span class="pl-1"><%= t('nav.faq') %></span>
          </div>
        </a>

        <a href="<%= precautionary_measures_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-exclamation-circle"></i>
            <span class="pl-1"><%= t('nav.precautionary_measures') %></span>
          </div>
        </a>

        <a href="<%= blogs_path type: "success_story" %>" class="bk-active">
          <div class="">
            <i class="fas fa-hand-holding-heart"></i>
            <%= t('nav.success_stories') %>
          </div>
        </a>

        <a href="<%= blogs_path %>" class="bk-active">
          <div class="">
            <i class="far fa-newspaper"></i>
            <%= t('nav.blogs') %>
          </div>
        </a>

        <a href="<%= market_places_path %>" class="bk-active">
          <div class="">
            <i class="fas fa-store"></i>
            <%= t('nav.wedding_shopping') %>
          </div>
        </a>

        <div class="dropdown">
          <a class="nav-link dropdown-toggle" href="#" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <div class="menu-title">
              <i class="fas fa-hands-helping"></i>
              <%= t('nav.assisted_services') %>
            </div>
          </a>
          <div class="dropdown-menu" aria-labelledby="navbarDropdownMenuLink">
            <% AssistedService.order(:display_order).each do |assisted_service| %>
              <a class="dropdown-item" href="<%= assisted_service_path(assisted_service) %>">
                <%= assisted_service.name&.titleize %>
              </a>
            <% end %>
          </div>
        </div>

        <a href="<%= contact_path %>" class="bk-active">
          <div class="">
            <i class="far fa-address-card"></i>
            <%= t('nav.contact_us') %>
          </div>
        </a>
      </div>
    <% end %>
  </div>

  <div class="site-bar-footer text-white">
    <div class="pt-2 social-link">
      <%= render 'shared/social_media_link', text_color:'text-white' %>
    </div>

  </div>

</div>

<%# While the menu is open the Home/Matches/... bar is hidden, so the menu's last rows
    (e.g. the social links) are not covered by it %>
<style>body.bk-menu-open .bk-bottom-nav { display: none !important; }</style>
<script>
    function openNav() {
        document.getElementById("mySidebar").style.width = "265px";
        $("body").css("overflow", "hidden").addClass("bk-menu-open");
    }

    function closeNav() {
        document.getElementById("mySidebar").style.width = "0";
        $("body").css("overflow", "visible").removeClass("bk-menu-open");
    }
</script>
