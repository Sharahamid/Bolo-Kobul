<%# Real ad uploaded in Admin > Ads (About Us page); nothing shows when there is none %>
<% about_ad = Ad.active.about_us_page.first %>
<% if about_ad&.image&.attached? %>
  <div class="<%= ad_class(about_ad) %>" style="border:0.5px solid #eee; border-radius:12px; overflow:hidden; background:#fff; height:100%; display:flex; align-items:stretch;">
    <%= link_to about_ad.url.presence || '#', target: '_blank', rel: 'noopener', style: "display:block; width:100%;" do %>
      <%= image_tag about_ad.image_url, alt: about_ad.title.to_s,
                    style: "width:100%; height:100%; object-fit:contain; display:block; background:#fff;",
                    class: "img-responsive" %>
    <% end %>
  </div>
<% end %>
