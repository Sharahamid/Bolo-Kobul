<%# Shown by public/push-notifications.js only when this device can receive notifications %>
<style>
  .bk-push { display: flex; align-items: center; gap: 16px; max-width: 1140px; margin: 12px auto; padding: 14px 18px;
             background: #FFFFFF; border: 1px solid #F1E6C8; border-left: 4px solid #C99A16; border-radius: 12px;
             box-shadow: 0 4px 16px rgba(34, 34, 51, 0.06); box-sizing: border-box; }
  .bk-push[hidden] { display: none !important; }
  .bk-push__icon { flex: 0 0 40px; width: 40px; height: 40px; border-radius: 50%; background: #FBF4E2;
                   display: flex; align-items: center; justify-content: center; color: #C99A16; }
  .bk-push__text { flex: 1 1 auto; min-width: 0; }
  .bk-push__title { margin: 0 0 2px; font-size: 15px; font-weight: 700; color: #222233; line-height: 1.35; }
  .bk-push__body { margin: 0; font-size: 13px; color: #6E6E78; line-height: 1.5; }
  .bk-push__actions { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
  .bk-push__btn { appearance: none; border: 0; cursor: pointer; font-size: 14px; font-weight: 600; line-height: 1;
                  padding: 11px 18px; border-radius: 999px; white-space: nowrap; }
  .bk-push__btn--primary { background: #C99A16; color: #FFFFFF; }
  .bk-push__btn--primary:hover { background: #B38812; }
  .bk-push__btn--ghost { background: transparent; color: #6E6E78; }
  .bk-push__btn--ghost:hover { color: #222233; }
  @media (max-width: 600px) {
    .bk-push { flex-wrap: wrap; margin: 12px 16px; padding: 14px 16px; gap: 12px; }
    .bk-push__text { flex: 1 1 calc(100% - 56px); }
    .bk-push__actions { flex: 1 1 100%; justify-content: flex-end; }
  }
</style>
<div id="bk-push-prompt" class="bk-push" role="region" aria-label="Notifications" hidden>
  <div class="bk-push__icon" aria-hidden="true">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path>
      <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
    </svg>
  </div>
  <div class="bk-push__text">
    <p class="bk-push__title">Never miss a Kobul</p>
    <p class="bk-push__body">Get a notification when someone sends you a Kobul, accepts yours or messages you.</p>
  </div>
  <div class="bk-push__actions">
    <button type="button" class="bk-push__btn bk-push__btn--ghost" data-push-dismiss>Not now</button>
    <button type="button" class="bk-push__btn bk-push__btn--primary" data-push-enable>Turn on</button>
  </div>
</div>
