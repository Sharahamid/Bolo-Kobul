<%= form_for preference, remote: preference.new_record? ? false : true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: t('preference.short_title') unless preference.new_record? %>

  <!-- Modal body -->
  <div class=" <%= preference.new_record? ? '' : 'modal-body' %>">

    <div class="form-group">
      <div class="row">
        <div class="col-6 pr-1">
          <%= f.label :gender, t('preference.looking_for') %>
          <%= f.select :gender,
                       options_for_select(PartnerPreference::genders.filter { |k, _| k != current_active_profile.gender }.map { |k, _| [I18n.t("enums.looking_for.#{k}", default: current_active_profile.gender_translate(k)), k] },
                                          selected: current_active_profile.preferred_gender),
                       {include_blank: false}, class: 'form-control sign_up-input-field selectpicker',
                       data: {toggle: "tooltip", placement: "top"}, title: t('preference.looking_for_req') %>
          <small class="text-danger"> <%= f.object.errors[:gender].present? ? f.object.errors.full_messages_for(:gender).first : '' %> </small>
        </div>
        <div class="col-6 pl-1">
          <%= f.label :religion %>
          <%= f.select :religion,
                       enum_options(:marriage_profile, :religion, PartnerPreference.values_for_religion.sort), {},
                       multiple: true,
                       autofocus: true, required: true,
                       class: 'form-control sign_up-input-field selectpicker',
                       data: {selected_text_format: 'values'} %>
          <small class="text-danger">
            <%= f.object.errors[:religion].present? ? f.object.errors.full_messages_for(:religion).first : '' %>
          </small>
        </div>
      </div>
    </div>

    <div class="form-group">
      <div class="row">
        <div class="col-6 pr-1">
          <%= f.label :min_age %>
          <%= f.number_field :min_age, min: 18, autocomplete: 'max_age',
                             class: 'form-control sign_up-input-field',
                             placeholder: t('preference.age_min_18'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.age_min') %>
          <small class="text-danger">
            <%= f.object.errors[:min_age].present? ? f.object.errors.full_messages_for(:min_age).first : '' %>
          </small>
        </div>
        <div class="col-6 pl-1">
          <%= f.label :max_age %>
          <%= f.number_field :max_age, autocomplete: 'max_age', min: 18, class: 'form-control sign_up-input-field',
                             placeholder: t('preference.age_max'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.age_max') %>
          <small class="text-max-age"><%= t('preference.age_error') %></small>
          <small class="text-danger">
            <%= f.object.errors[:max_age].present? ? f.object.errors.full_messages_for(:max_age).first : '' %>
          </small>
        </div>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :hometown, t('preference.hometown') %>
      <%= f.select :hometown,
                   district_options(District.order_by_name.pluck(:name)),
                   {include_blank: false},
                   multiple: true,
                   class: 'form-control sign_up-input-field selectpicker',
                   id: 'pref_hometown_select',
                   placeholder: t('preference.hometown') %>
      <small class="text-danger">
        <%= f.object.errors[:hometown].present? ? f.object.errors.full_messages_for(:hometown).first : '' %>
      </small>
    </div>
    <div id="pref_hometown_abroad_fields" class="mb-3" style="display:none;">
      <div class="row mt-2">
        <div class="col-6">
          <%= f.select :hometown_country, options_for_select(Country.order(:name).pluck(:name), f.object.hometown_country), {prompt: t('form.country_req')}, class: 'form-control sign_up-input-field', id: 'pref_hometown_country_input' %>
        </div>
        <div class="col-6">
          <%= f.text_field :hometown_city, placeholder: t('form.city_req'), class: 'form-control sign_up-input-field', id: 'pref_hometown_city_input' %>
        </div>
      </div>
    </div>
    <div class="form-group">
      <%= f.label :except_hometown, t('preference.except_hometown') %>
      <%= f.select :except_hometown,
                   district_options(District.order_by_name.pluck(:name)),
                   {include_blank: false},
                   multiple: true,
                   class: 'form-control sign_up-input-field selectpicker',
                   id: 'pref_except_hometown_select',
                   placeholder: t('preference.except_hometown') %>
    </div>
    <div id="pref_except_hometown_abroad_fields" class="mb-3" style="display:none;">
      <div class="row mt-2">
        <div class="col-6">
          <%= f.select :except_hometown_country, options_for_select(Country.order(:name).pluck(:name), f.object.except_hometown_country), {prompt: t('form.country_req')}, class: 'form-control sign_up-input-field', id: 'pref_except_hometown_country_input' %>
        </div>
        <div class="col-6">
          <%= f.text_field :except_hometown_city, placeholder: t('form.city_req'), class: 'form-control sign_up-input-field', id: 'pref_except_hometown_city_input' %>
        </div>
      </div>
    </div>
    <div class="form-group">
      <%= f.label :present_location, t('preference.present_location') %>
      <%= f.select :present_location,
                   district_options(District.order_by_name.pluck(:name)),
                   {include_blank: false},
                   multiple: true,
                   class: 'form-control sign_up-input-field selectpicker',
                   id: 'pref_present_location_select',
                   title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:present_location].present? ? f.object.errors.full_messages_for(:present_location).first : '' %>
      </small>
    </div>
    <div id="pref_present_location_abroad_fields" class="mb-3" style="display:none;">
      <div class="row mt-2">
        <div class="col-6">
          <%= f.select :present_location_country, options_for_select(Country.order(:name).pluck(:name), f.object.present_location_country), {prompt: t('form.country_req')}, class: 'form-control sign_up-input-field', id: 'pref_present_location_country_input' %>
        </div>
        <div class="col-6">
          <%= f.text_field :present_location_city, placeholder: t('form.city_req'), class: 'form-control sign_up-input-field', id: 'pref_present_location_city_input' %>
        </div>
      </div>
    </div>
<script>
(function() {
  function setupPrefAbroadField(selectId, fieldId) {
    var select = document.getElementById(selectId);
    var field = document.getElementById(fieldId);
    if (!select || !field) return;
    function toggle() {
      var selected = Array.from(select.selectedOptions).map(o => o.value);
      if (selected.includes('Outside Bangladesh')) {
        field.style.display = 'block';
      } else {
        field.style.display = 'none';
      }
    }
    $(select).on('changed.bs.select change', toggle);
    toggle();
  }
  setupPrefAbroadField('pref_hometown_select', 'pref_hometown_abroad_fields');
  setupPrefAbroadField('pref_present_location_select', 'pref_present_location_abroad_fields');
  setupPrefAbroadField('pref_except_hometown_select', 'pref_except_hometown_abroad_fields');
})();
</script>
    <div class="form-group">
      <%= f.label :marital_status %>
      <%= f.select :marital_status,
                   enum_options(:marriage_profile, :marital_status, PartnerPreference.values_for_marital_status.sort),
                   {},
                   multiple: true,
                   class: 'form-control sign_up-input-field selectpicker',
                   title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:marital_status].present? ? f.object.errors.full_messages_for(:marital_status).first : '' %>
      </small>
    </div>

    <div class="form-group">
      <div class="row">
        <div class="col-6 pr-1">
          <%= f.label :min_height %>
          <%= f.number_field :min_height, min: 1, max: 10,
                             autocomplete: 'min_height', class: 'form-control sign_up-input-field',
                             placeholder: t('preference.feet_min'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.feet_min') %>
          <small class="text-danger">
            <%= f.object.errors[:min_height].present? ? f.object.errors.full_messages_for(:min_height).first : '' %>
          </small>
        </div>
        <div class="col-6 pl-1">
          <%= f.label :min_inch %>
          <%= f.number_field :min_inch, min: 0, max: 11,
                             autocomplete: 'min_inch', class: 'form-control sign_up-input-field',
                             placeholder: t('preference.inch_min'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.inch_min') %>
          <small class="text-danger">
            <%= f.object.errors[:min_inch].present? ? f.object.errors.full_messages_for(:min_inch).first : '' %>
          </small>
        </div>
      </div>
    </div>

    <div class="form-group">
      <div class="row">
        <div class="col-6 pr-1">
          <%= f.label :max_height %>
          <%= f.number_field :max_height, min: 1, max: 11, autocomplete: 'max_height',
                             class: 'form-control sign_up-input-field',
                             placeholder: t('preference.feet_max'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.feet_max') %>
          <small class="text-max-height"><%= t('preference.height_error') %></small>
          <small class="text-danger"> <%= f.object.errors[:max_height].present? ? f.object.errors.full_messages_for(:max_height).first : '' %> </small>
        </div>
        <div class="col-6 pl-1">
          <%= f.label :max_inch %>
          <%= f.number_field :max_inch, min: 0, max: 11,
                             autocomplete: 'max_inch',
                             class: 'form-control sign_up-input-field',
                             placeholder: t('preference.inch_max'), data: {toggle: 'tooltip', placement: 'top'},
                             title: t('preference.inch_max') %>
          <small class="text-max-inch"><%= t('preference.inch_error') %></small>
          <small class="text-danger"> <%= f.object.errors[:max_inch].present? ? f.object.errors.full_messages_for(:max_inch).first : '' %> </small>
        </div>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :highest_education_level, t('preference.education') %>
      <%= f.select :highest_education_level,
                   enum_options(:marriage_profile, :highest_education_level, PartnerPreference::highest_education_levels.sort_by { |k, v| k }.to_h.keys),
                   {prompt: t('preference.nothing_selected')},
                   class: 'form-control sign_up-input-field selectpicker',
                   title: t('preference.nothing_selected') %>
      <small class="text-danger"> <%= f.object.errors[:highest_education_level].present? ? f.object.errors.full_messages_for(:highest_education_level).first : '' %> </small>
    </div>

    <div class="form-group">
      <%= f.label :physical_status %>
      <%= f.select :physical_status,
                   enum_options(:appearance, :physical_status, PartnerPreference::physical_statuses.sort_by { |k, v| k }.to_h.keys),
                   {prompt: t('preference.nothing_selected')}, class: 'form-control sign_up-input-field selectpicker', title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:physical_status].present? ? f.object.errors.full_messages_for(:physical_status).first : '' %>
      </small>
    </div>

    <div class="form-group">
      <%= f.label :family_type %>
      <%= f.select :family_type,
                   enum_options(:marriage_profile, :family_type, PartnerPreference::family_types.map.sort_by { |k, v| k }.to_h.keys),
                   {prompt: t('preference.nothing_selected')}, class: 'form-control sign_up-input-field selectpicker', title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:family_type].present? ? f.object.errors.full_messages_for(:family_type).first : '' %>
      </small>
    </div>

    <div class="form-group">
      <%= f.label :family_status %>
      <%= f.select :family_status,
                   enum_options(:marriage_profile, :family_status, PartnerPreference::family_statuses.map.sort_by { |k, v| k }.to_h.keys),
                   {prompt: t('preference.nothing_selected')}, class: 'form-control sign_up-input-field selectpicker', title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:family_status].present? ? f.object.errors.full_messages_for(:family_status).first : '' %>
      </small>
    </div>

    <div class="form-group">
      <%= f.label :family_values %>
      <%= f.select :family_values,
                   enum_options(:marriage_profile, :family_values, PartnerPreference::family_values.map.sort_by { |k, v| k }.to_h.keys),
                   {prompt: t('preference.nothing_selected')}, class: 'form-control sign_up-input-field selectpicker', title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:family_values].present? ? f.object.errors.full_messages_for(:family_values).first : '' %>
      </small>
    </div>

    <div class="<%= preference.new_record? ? 'form-group' : '' %>">
      <%= f.label :blood_group %>
      <%= f.select :blood_group,
                   PartnerPreference::BLOOD_GROUPS,
                   {include_blank: false},
                   multiple: true,
                   class: 'form-control sign_up-input-field selectpicker',
                   title: t('preference.nothing_selected') %>
      <small class="text-danger">
        <%= f.object.errors[:blood_group].present? ? f.object.errors.full_messages_for(:blood_group).first : '' %>
      </small>
    </div>

  </div>
  <% if preference.new_record? %>
    <div class="register-btn-section text-center">
      <button type="submit" class="btn btn-sign_up form-control"><%= t('form.next') %></button>
    </div>
  <% end %>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f unless preference.new_record? %>

<% end %>

<script>
    $('.selectpicker').selectpicker({ noneSelectedText: <%= raw t('preference.nothing_selected').to_json %> });
</script>
