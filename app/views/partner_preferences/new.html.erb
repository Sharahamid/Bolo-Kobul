<div class="container-fluid p-0">
  <div class="container">
    <div class="basic_info">
      <div class="basic-info-mandala">
        <%= image_tag 'mandala.svg', class: 'img-responsive' %>
      </div>
      <div class="d-flex flex-column align-items-center">
        <div class="internal_form_heading align-self-center text-center">
          <span style="display:block; width:41px; height:4px; background:#FFB627; margin:0 auto 6px;"></span>
          <h1 style="font-size:20px; font-weight:700; color:#1a1a1a; margin:0;"><%= profile_t('pref_heading', current_active_profile) %></h1>
        </div>
        <%= link_to "← #{t('preference.back_to_basics')}", new_marriage_profile_path, class: 'align-self-start pl-2 pt-2 bk-back-basics',
                    style: 'font-size:13px; color:#B97A00; font-weight:600; text-decoration:none;' %>
        <div class="form_title align-self-start pt-3 pl-2 pr-2">
          <strong> <%= t('preference.short_title') %> </strong> <br>
          <%= image_tag 'yellow_line.svg', width: '80', height: '17' %>
        </div>
        <div class="form_input_fields pt-4 pl-2 pr-2 col-12">
          <%= render 'partner_preferences/preference_form', preference: @preference %>
        </div>
        <script>
          // Remember what is typed here (in this browser tab, for this profile only), so going
          // back to the Basics step and returning does not lose it
          (function () {
            var form = document.querySelector('.form_input_fields form');
            if (!form) return;
            var key = 'bk-pref-draft-<%= current_active_profile&.id %>';
            function save() {
              var draft = {};
              Array.prototype.forEach.call(form.elements, function (el) {
                if (!el.name || el.type === 'hidden' || el.type === 'submit' || el.name === 'authenticity_token') return;
                if (el.tagName === 'SELECT' && el.multiple) draft[el.name] = Array.prototype.filter.call(el.options, function (o) { return o.selected; }).map(function (o) { return o.value; });
                else if (el.type === 'checkbox' || el.type === 'radio') { if (el.checked) (draft[el.name] = draft[el.name] || []).push(el.value); }
                else draft[el.name] = el.value;
              });
              try { sessionStorage.setItem(key, JSON.stringify(draft)); } catch (e) {}
            }
            function restore() {
              var draft;
              try { draft = JSON.parse(sessionStorage.getItem(key) || 'null'); } catch (e) {}
              if (!draft) return;
              Array.prototype.forEach.call(form.elements, function (el) {
                if (!el.name || !(el.name in draft) || el.type === 'hidden') return;
                var value = draft[el.name];
                if (el.tagName === 'SELECT' && el.multiple) Array.prototype.forEach.call(el.options, function (o) { o.selected = value.indexOf(o.value) !== -1; });
                else if (el.type === 'checkbox' || el.type === 'radio') el.checked = value.indexOf(el.value) !== -1;
                else el.value = value;
              });
              if (window.jQuery && jQuery.fn.selectpicker) jQuery(form).find('.selectpicker').selectpicker('refresh');
            }
            <% if @preference.errors.empty? %>restore();<% end %>
            form.addEventListener('change', save);
            form.addEventListener('input', save);
          })();
        </script>

      </div>

    </div>
  </div>
</div>