<%= form_for marriage_info, remote: true do |f| %>
  <!-- Modal Header -->
  <%= render 'shared/modal_header', title: marriage_info.new_record? ? t('section_form.add_marriage_info') : t('section_form.edit_marriage_info'), f: f %>

  <!-- Modal body -->
  <div class="modal-body">
    <div class="form_input_fields pl-2 pr-2">

      <div class="form-group">
        <%= f.check_box :have_children, class: 'js-have-children' %>
        <%= f.label :have_children, t('section_form.have_children') %>
        <small class="text-danger"> <%= f.object.errors[:have_children].present? ? f.object.errors.full_messages_for(:have_children).first : '' %> </small>
      </div>

      <div class="form-group">
        <%= f.number_field :no_of_childrens,
                           min: 0, placeholder: t('section_form.no_of_children_req'),
                           class: 'form-control sign_up-input-field js-no-of-childrens'
        %>
        <small class="text-danger"> <%= f.object.errors[:no_of_childrens].present? ? f.object.errors.full_messages_for(:no_of_childrens).first : '' %> </small>
      </div>

      <div class="">
        <%= f.check_box :want_more_child %>
        <%= f.label :want_more_child, t('section_form.want_child') %>
        <small class="text-danger"> <%= f.object.errors[:want_more_child].present? ? f.object.errors.full_messages_for(:want_more_child).first : '' %> </small>
      </div>

    </div>
  </div>

  <!-- Modal footer -->
  <%= render 'shared/modal_footer', f: f %>
<% end %>

<script type="text/javascript" charset="utf-8">
    checkchildrens('.js-have-children');
    $(document).on('click', ".js-have-children", function () {
        checkchildrens(this);
    });

    function checkchildrens(children) {
        if ($(children).prop('checked') == true) {
            $('.js-no-of-childrens').show();
        } else {
            $('.js-no-of-childrens').hide();
            $('.js-no-of-childrens').val('');
        }
    }
</script>