<% content_for :title, t('bkx.plus.page_title') %>
<%= render 'bk_plus/styles' %>
<div class="bkp-wrap">
  <div class="bkp-card">
    <div class="bkp-hero">
      <div class="bkp-logo">BK<span>+</span></div>
      <p><%= t('bkx.plus.tagline') %></p>
    </div>
    <div class="bkp-body">
      <div class="bkp-benefit">
        <div class="bkp-ico"><i class="fas fa-crown"></i></div>
        <div><h3><%= t('bkx.plus.b1_title') %></h3><p><%= t('bkx.plus.b1_text') %></p></div>
      </div>
      <div class="bkp-benefit">
        <div class="bkp-ico"><i class="fas fa-arrow-up"></i></div>
        <div><h3><%= t('bkx.plus.b2_title') %></h3><p><%= t('bkx.plus.b2_text') %></p></div>
      </div>
      <div class="bkp-benefit">
        <div class="bkp-ico"><i class="fas fa-heart"></i></div>
        <div>
          <h3><%= t('bkx.plus.b3_title') %></h3>
          <p><%= t('bkx.plus.b3_text') %>
            <% if @saved_count.positive? %><br><strong style="color:#854F0B;"><%= t('bkx.plus.saved_count', count: @saved_count, n: local_digits(@saved_count)) %></strong><% end %>
          </p>
        </div>
      </div>
      <div class="bkp-benefit">
        <div class="bkp-ico"><i class="fas fa-eye"></i></div>
        <div>
          <h3><%= t('bkx.plus.b5_title') %></h3>
          <p><%= t('bkx.plus.b5_text') %>
            <% if @view_count.positive? %><br><strong style="color:#854F0B;"><%= t('bkx.plus.viewed_count', count: @view_count, n: local_digits(@view_count)) %></strong><% end %>
          </p>
        </div>
      </div>
      <div class="bkp-benefit">
        <div class="bkp-ico">🦋</div>
        <div><h3><%= t('bkx.plus.b4_title_plans') %></h3><p><%= t('bkx.plus.b4_text_plans') %></p></div>
      </div>

      <% if @member %>
        <div class="bkp-status" style="margin-top:16px;">
          <span class="bkp-badge">BK+</span>
          <%= t('bkx.plus.active_until', date: l(current_user.bk_plus_until.in_time_zone('Asia/Dhaka').to_date, format: :long)) %>
        </div>
        <div style="display:flex; gap:10px; margin-top:12px; flex-wrap:wrap;">
          <a class="bkp-btn bkp-btn--ghost" style="flex:1 1 180px;" href="<%= bk_plus_saved_you_path %>"><i class="fas fa-heart"></i> <%= t('bkx.plus.see_who') %></a>
          <a class="bkp-btn bkp-btn--ghost" style="flex:1 1 180px;" href="<%= bk_plus_viewed_you_path %>"><i class="fas fa-eye"></i> <%= t('bkx.plus.viewed_title') %></a>
        </div>
      <% end %>

      <% unless play_store_app? %>
        <% plans = BkPlusPlan.for_sale.to_a %>
        <% if plans.any? %>
          <% best = plans.min_by(&:price_per_week) %>
          <% default_plan = plans.find { |p| [30, 31].include?(p.days) } || plans.first %>
          <h3 class="bkp-plans-title"><%= @member ? t('bkx.plus.choose_renew') : t('bkx.plus.choose') %></h3>
          <%= form_for Order.new, html: { id: 'bkp-plan-form' } do |f| %>
            <%= f.hidden_field :payment_method, value: 'foster_payment' %>
            <%= f.hidden_field :product, value: 'bk_plus' %>
            <%= f.hidden_field :quantity, value: 1 %>
            <div class="bkp-plans" role="radiogroup">
              <% plans.each do |plan| %>
                <label class="bkp-plan">
                  <input type="radio" name="order[bk_plus_plan_id]" value="<%= plan.id %>" <%= 'checked' if plan == default_plan %> required>
                  <span class="bkp-plan__box">
                    <% if plan == best && plans.size > 1 %><span class="bkp-plan__tag"><%= t('bkx.plus.best_value') %></span><% end %>
                    <span class="bkp-plan__name"><%= plan.label %></span>
                    <span class="bkp-plan__price">৳<%= taka(plan.price) %></span>
                    <span class="bkp-plan__bonus">+ <%= t('bkx.plus.plan_bonus', count: plan.butterflies, n: local_digits(plan.butterflies)) %></span>
                    <% if plan.days > 7 %><span class="bkp-plan__week"><%= t('bkx.plus.per_week', price: taka(plan.price_per_week)) %></span><% end %>
                  </span>
                </label>
              <% end %>
            </div>
            <% if user_signed_in? %>
              <button type="submit" class="bkp-btn"><%= @member ? t('bkx.plus.renew') : t('bkx.plus.join') %></button>
              <p class="bkp-note"><%= t('bkx.plus.note') %></p>
            <% end %>
          <% end %>
          <% unless user_signed_in? %>
            <a class="bkp-btn" href="#" data-toggle="modal" data-target="#loginModal"><%= t('bkx.plus.login_to_join') %></a>
          <% end %>
        <% elsif !@member %>
          <p class="bkp-note" style="margin-top:16px;"><%= t('bkx.plus.coming_soon') %></p>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
